---
import '../styles/global.css';
import { getSettings, setting } from '../lib/db';
import { makeAbs } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Path or absolute URL. Defaults to the current page. */
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  keywords?: string;
  noindex?: boolean;
  /**
   * Share-card overrides. Each falls back to the page title/description when
   * blank, which is what lets the admin leave them empty and still ship correct
   * tags — but when set they MUST win, or the admin's Social panel would be
   * writing to fields nothing renders.
   */
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  /**
   * OG article:* metadata. Emitted only when ogType === 'article', so a non-article
   * page passing none of these changes nothing. The ranking-relevant values already
   * live in the BlogPosting JSON-LD; these mirror them into the OG namespace that
   * Facebook/LinkedIn cards and several SEO crawlers read.
   */
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  /** JSON-LD graph node(s) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  keywords,
  noindex = false,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  twitterImage,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  jsonLd,
} = Astro.props;

const settings = await getSettings();
const siteName = setting(settings, 'site_name', 'Ibrahim Maher Al-Bander');
const siteUrl = setting(settings, 'site_url', 'https://ibrahimaher.com').replace(/\/$/, '');
const gaId = setting(settings, 'ga_measurement_id'); // blank disables analytics
const defaultOg = setting(settings, 'default_og_image', '/assets/og/default.png');
const defaultOgAlt = setting(settings, 'default_og_image_alt');
const ogLocale = setting(settings, 'og_locale', 'en_US');
const googleVerification = setting(settings, 'google_site_verification');
const bingVerification = setting(settings, 'bing_site_verification');

/**
 * Settings booleans are TEXT '0'/'1' (settings.value is TEXT; the admin checkbox
 * writes back `checked ? '1' : '0'`). Compare against '1' explicitly — the string
 * '0' is truthy in JS, so `if (value)` would read an unticked box as ticked and
 * noindex the entire site.
 */
const forceNoindex = setting(settings, 'robots_noindex') === '1';
const bigImagePreview = setting(settings, 'robots_max_image_preview') === '1';

// Same logic this file always had, now shared: blog/[slug].astro concatenated
// its own and shipped a doubled origin in every post's JSON-LD. See lib/url.ts.
const abs = makeAbs(siteUrl);

const canonicalUrl = canonical ? abs(canonical) : abs(Astro.url.pathname);
const shareImage = abs(ogImage || defaultOg);

/**
 * The dynamic /og/* cards and the static /assets/og-image.png fallback are all
 * exactly 1200x630, so their dimensions can be declared. A page passing its own
 * arbitrary ogImage may be any size, so dimensions are declared only for these
 * known-standard share images — never guessed for a custom one.
 */
const stdShareImage = shareImage.includes('/og/') || shareImage.endsWith('og-image.png');

/**
 * Preview deploys (*.workers.dev) serve byte-identical content to production,
 * which is textbook duplicate content. Any host that is not the canonical one
 * is marked noindex automatically, so a preview can never compete with the real
 * site in the index. Canonical tags alone are a hint; this is not.
 */
const canonicalHost = new URL(siteUrl).host;
const isCanonicalHost = Astro.url.host === canonicalHost;
const blockIndexing = noindex || !isCanonicalHost || forceNoindex;

/**
 * One robots tag, not two. `max-image-preview:large` is an indexing hint, so it
 * is meaningless on a page that is already noindex — emitting both would be a
 * self-contradicting tag. Blocking always wins; the preview hint only applies to
 * pages that are actually indexable.
 */
const robotsContent = blockIndexing
  ? 'noindex, nofollow'
  : bigImagePreview
    ? 'max-image-preview:large'
    : '';

// Resolve the share card once, so og:* and twitter:* cannot drift apart.
const shareTitle = ogTitle || title;
const shareDesc = ogDescription || description;
const xTitle = twitterTitle || shareTitle;
const xDesc = twitterDescription || shareDesc;
const xImage = twitterImage ? abs(twitterImage) : shareImage;

/**
 * The admin's handle box is free text, so accept the three things a human will
 * actually put in it — `ibrahim`, `@ibrahim`, or a pasted profile URL — and
 * normalise to the `@name` form. X drops twitter:site outright if the value is
 * not exactly that shape, which fails silently: the card still renders, just
 * without attribution, so there is nothing to notice.
 *
 * The scheme is OPTIONAL in that first replace for a reason: Chrome's address
 * bar displays `x.com/ibrahim` and hides the `https://`, so copying what is on
 * screen — the single most likely way this box gets a URL — yields a schemeless
 * one. Requiring the scheme matched neither, left the host in place, and the tag
 * shipped as `@x.com`: still the wrong-shape value X silently discards, only now
 * from a paste that looked perfectly reasonable.
 */
const handleName = setting(settings, 'twitter_handle')
  .trim()
  .replace(/^(?:https?:\/\/)?(?:www\.)?(?:twitter|x)\.com\//i, '')
  .replace(/^@/, '')
  .replace(/[/?#].*$/, '');
const twitterHandle = handleName ? `@${handleName}` : '';

/**
 * The alt setting describes the DEFAULT share image specifically, so it may only
 * be emitted when that image is the one actually on the card. A post carrying its
 * own hero picture is described by its own alt text — captioning it with the
 * site-wide default would state something untrue about the image to exactly the
 * readers who depend on alt text most.
 */
const ogAltApplies = defaultOgAlt !== '' && !ogImage;
const xAltApplies = ogAltApplies && !twitterImage;

const ldArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const nav = [
  { href: '/', label: 'Home' },
  { href: '/n8n-developer', label: 'Hire me' },
  { href: '/about', label: 'About' },
  { href: '/blog/', label: 'Writing' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonicalUrl} />
    {robotsContent && <meta name="robots" content={robotsContent} />}

    {/*
      Search-engine ownership proofs. Both are emitted only when set: an empty
      content="" is not a harmless no-op — Search Console reads it as a failed
      verification rather than an absent one.
    */}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={shareImage} />
    {/*
      Dimensions let Facebook/LinkedIn render the large summary card on the FIRST
      scrape, before they fetch and decode the file. Emitted only for the fixed
      1200x630 default share image — a page passing its own ogImage may be any
      size, so its dimensions are left unstated rather than mis-declared.
    */}
    {stdShareImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {ogAltApplies && <meta property="og:image:alt" content={defaultOgAlt} />}
    <meta property="og:locale" content={ogLocale} />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={xTitle} />
    <meta name="twitter:description" content={xDesc} />
    <meta name="twitter:image" content={xImage} />
    {xAltApplies && <meta name="twitter:image:alt" content={defaultOgAlt} />}

    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Writing`} href="/rss.xml" />

    {/* Self-hosted fonts: preload the two faces used above the fold. */}
    <link rel="preload" href="/assets/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Set the theme before first paint so there is no flash of the wrong one. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    {ldArray.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}

    {/*
      Google Analytics — same measurement ID and the same deferral trick as the
      previous site: gtag.js only loads on first interaction (or after 15s), so
      it stays off the critical path and out of the LCP measurement.
      The ID now comes from the settings table; blank disables analytics entirely.
    */}
    {gaId && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.google-analytics.com" />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
          (function () {
            var loaded = false;
            var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
            function loadGtag() {
              if (loaded) return;
              loaded = true;
              clearTimeout(fallback);
              events.forEach(function (evt) {
                window.removeEventListener(evt, loadGtag, { passive: true });
              });
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
              document.head.appendChild(s);
            }
            events.forEach(function (evt) {
              window.addEventListener(evt, loadGtag, { passive: true, once: true });
            });
            var fallback = setTimeout(loadGtag, 15000);
          })();
        </script>
      </>
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        {/*
          IMB monogram. The letters are decorative — the anchor carries the real
          accessible name, so a screen reader announces the full name rather than
          spelling out three letters.
        */}
        <a class="wordmark" href="/" aria-label={`${siteName} — home`}>
          <span class="wordmark__mark" aria-hidden="true">
            <span class="wordmark__i">I</span><span class="wordmark__m">M</span><span
              class="wordmark__b">B</span>
          </span>
          <span class="wordmark__rule" aria-hidden="true"></span>
        </a>

        <nav aria-label="Primary">
          <ul class="nav">
            {nav.map((item) => {
              const active =
                item.href === '/' ? path === '/' : path.startsWith(item.href.replace(/\/$/, ''));
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={['nav__link', { 'is-active': active }]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Switch between light and dark mode"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.2"></circle>
            <path
              d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </header>

    {/* tabindex=-1 so the skip link moves keyboard focus here, not just scroll —
        WebKit does not reliably move focus to a non-focusable fragment target. It
        is not a tab stop, and its focus ring is suppressed below since the reader
        triggered the jump deliberately. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p class="muted">Designed and built by {siteName}. Written by hand, in Erbil.</p>
        <p class="muted">&copy; {year}</p>
      </div>
    </footer>

    <script>
      // Theme toggle. Respects the OS setting until the reader overrides it.
      //
      // This deliberately does NOT use the View Transitions API. It was tried,
      // and measured on a 4x-throttled phone it cost a 195ms frozen frame plus
      // three ~95ms long tasks: startViewTransition has to rasterise the whole
      // document to a texture before it can animate anything, and this page is
      // long. The effect was pretty and the interaction was junk.
      //
      // Instead: one fixed, solid-colour layer painted in the OUTGOING
      // background, sitting above the page while the theme swaps underneath it,
      // then faded out. Only `opacity` on a single element animates, so it runs
      // entirely on the compositor — no snapshot, no relayout, no repaint of the
      // page beneath. The swap itself is always synchronous, so the toggle
      // cannot break if anything else fails.
      const btn = document.getElementById('theme-toggle');

      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';

        const apply = () => {
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
        };

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !document.body.animate) {
          apply();
          return;
        }

        // Capture the colour we are leaving BEFORE the swap.
        const from = getComputedStyle(root).getPropertyValue('--paper').trim();

        const veil = document.createElement('div');
        veil.className = 'theme-veil';
        veil.style.background = from;
        document.body.appendChild(veil);

        apply();

        const anim = veil.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
        );
        // finally() rather than onfinish: if the animation is cancelled (fast
        // double-tap), the veil must still be removed or it covers the page.
        anim.finished.catch(() => {}).finally(() => veil.remove());
      });
    </script>

    <style is:global>
      /*
        The theme veil is appended to <body> by the toggle script, so it cannot
        be an Astro-scoped style — a scoping attribute would never match an
        element created at runtime and the rules would silently do nothing.

        It is a single solid layer. `will-change: opacity` promotes it up front
        so the fade never triggers a paint of the page underneath, and
        `pointer-events: none` means it can never eat a click even if a stray
        one survives.
      */
      .theme-veil {
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        will-change: opacity;
        contain: strict;
      }
    </style>

    <style>
      /*
        Opaque by default. A translucent sticky bar means backdrop-filter has to
        re-blur whatever scrolls beneath it on every frame — one of the most
        expensive things you can ask a mobile GPU to do, and a real source of
        scroll jank. The blur is treated as a progressive enhancement and only
        enabled for fine pointers (desktop) on wider viewports, where the cost
        is affordable. Phones get a solid bar that looks near-identical and
        scrolls at full frame rate.
      */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--paper);
        border-bottom: var(--rule) solid var(--rule-color);
      }

      @media (min-width: 60rem) and (pointer: fine) {
        @supports (backdrop-filter: blur(1px)) {
          .site-header {
            background: color-mix(in oklab, var(--paper) 82%, transparent);
            backdrop-filter: blur(10px);
          }
        }
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-m);
        min-height: 4rem;
      }

      /*
        Measured at 320px: the monogram + four links + toggle needed 365px, so the
        page scrolled sideways and flex crushed the toggle to 14px wide. Below
        34rem the header becomes two rows — mark and toggle on the first, nav
        spread across the second. No JS, no hamburger to open, every destination
        stays one tap away, and nothing is hidden behind an icon.
      */
      @media (max-width: 34rem) {
        .site-header__inner {
          flex-wrap: wrap;
          gap: 0 var(--space-s);
          padding-block: var(--space-2xs);
        }

        .site-header__inner > nav {
          order: 3;
          flex-basis: 100%;
        }

        .nav {
          justify-content: space-between;
          gap: var(--space-2xs);
        }
      }

      /*
        IMB monogram.

        Set in Sora at its heaviest weight with the tracking pulled well past the
        body scale (-0.07em vs -0.03em). That negative tracking is what separates
        a logotype from ordinary bold text: at three letters the counters can sit
        much closer than reading text would ever allow, and the trio starts to
        read as one drawn mark rather than an abbreviation.

        Optical detail: the I is narrowed and the B is set in the accent, so the
        eye lands left-to-right on a mark with a weighted terminal rather than
        three even slabs.
      */
      .wordmark {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.28rem;
        text-decoration: none;
        font-family: var(--font-display);
      }

      .wordmark__mark {
        display: inline-flex;
        align-items: baseline;
        font-weight: 800;
        font-size: 1.32rem;
        line-height: 1;
        letter-spacing: -0.07em;
        color: var(--ink);
        /* Sora's caps sit slightly left in their box; nudge the lockup so the
           I aligns optically with the page gutter rather than mathematically. */
        margin-left: -0.02em;
      }

      .wordmark__i {
        /* The I carries far less width than its sidebearings suggest. */
        margin-right: 0.04em;
      }

      .wordmark__b {
        color: var(--accent-ink);
      }

      /* Sized to the hover width and scaled DOWN at rest, so the animation is a
         transform rather than an animated `width`. Animating width relayouts the
         header every frame; scaleX is composited. The box never changes size, so
         the nav beside it cannot shift. */
      /* The rule underlines the monogram and extends on hover. Sized to its full
         width and scaled down at rest so the animation is a composited transform,
         never an animated `width` (which would relayout the header every frame). */
      .wordmark__rule {
        display: block;
        width: 3.1rem;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0.62);
        transform-origin: left center;
        transition: transform var(--dur-mid) var(--ease-out);
      }

      @media (hover: hover) {
        .wordmark:hover .wordmark__rule {
          transform: none;
        }
      }

      .nav {
        display: flex;
        gap: clamp(0.75rem, 2.5vw, 1.75rem);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav__link {
        font-size: var(--step--1);
        text-decoration: none;
        color: var(--ink-2);
        position: relative;
        padding-block: 0.35rem;
        transition: color var(--dur-fast) var(--ease-out);
      }

      .nav__link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        height: 1px;
        width: 100%;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--dur-mid) var(--ease-out);
      }

      .nav__link.is-active {
        color: var(--ink);
      }

      .nav__link.is-active::after {
        transform: scaleX(1);
      }

      /* Hover is gated: a phone emulates it on tap and then leaves the state
         stuck on the last-tapped link. */
      @media (hover: hover) {
        .nav__link:hover {
          color: var(--ink);
        }

        .nav__link:hover::after {
          transform: scaleX(1);
        }
      }

      /* Touch targets. The visual size stays as designed; only the hit area
         grows, via padding on the link and a taller flex line. 44px is the
         accessibility floor and these were ~24-34px. */
      @media (pointer: coarse) {
        .nav__link {
          display: inline-flex;
          align-items: center;
          min-height: 44px;
          padding-inline: 0.15rem;
        }

        /* Measured 50x28 — the mark is the route home and was under the floor.
           justify-content keeps it optically top-aligned while the hit area grows
           downward, so the lockup does not visually drift. */
        .wordmark {
          min-height: 44px;
          justify-content: center;
        }
      }

      .theme-toggle {
        display: grid;
        place-items: center;
        /* Without this, flex happily shrank it to 14px wide when the header
           overflowed — a round button squashed into a sliver. */
        flex: none;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 999px;
        border: var(--rule) solid var(--rule-color);
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
        transition:
          color var(--dur-fast) var(--ease-out),
          border-color var(--dur-fast) var(--ease-out),
          transform var(--dur-mid) var(--ease-out);
      }

      @media (hover: hover) {
        .theme-toggle:hover {
          color: var(--accent-ink);
          border-color: var(--accent);
          transform: rotate(35deg);
        }
      }

      /* Must come AFTER the base .theme-toggle rule: a media query adds no
         specificity, so an earlier block would simply lose to the 2.1rem below. */
      @media (pointer: coarse) {
        .theme-toggle {
          width: 44px;
          height: 44px;
        }
      }

      .site-footer {
        border-top: var(--rule) solid var(--rule-color);
        margin-top: var(--space-2xl);
        padding-block: var(--space-l);
      }

      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-m);
        justify-content: space-between;
        font-size: var(--step--1);
      }

      .site-footer p {
        margin: 0;
      }

      /* The skip link's target. #main is focusable (tabindex=-1) only so focus
         lands here when the link is used; it is not a tab stop, so a focus ring
         on a whole-page region would be a jarring box with no keyboard purpose. */
      #main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
