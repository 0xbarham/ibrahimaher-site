---
import '../styles/global.css';
import { getSettings, setting } from '../lib/db';

interface Props {
  title: string;
  description: string;
  /** Path or absolute URL. Defaults to the current page. */
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  keywords?: string;
  noindex?: boolean;
  /**
   * Share-card overrides. Each falls back to the page title/description when
   * blank, which is what lets the admin leave them empty and still ship correct
   * tags — but when set they MUST win, or the admin's Social panel would be
   * writing to fields nothing renders.
   */
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  /** JSON-LD graph node(s) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  keywords,
  noindex = false,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  twitterImage,
  jsonLd,
} = Astro.props;

const settings = await getSettings();
const siteName = setting(settings, 'site_name', 'Ibrahim Maher Al-Bander');
const siteUrl = setting(settings, 'site_url', 'https://ibrahimaher.com').replace(/\/$/, '');
const gaId = setting(settings, 'ga_measurement_id'); // blank disables analytics
const defaultOg = setting(settings, 'default_og_image', '/assets/og-image.png');

const abs = (p: string) =>
  /^https?:\/\//.test(p) ? p : `${siteUrl}${p.startsWith('/') ? '' : '/'}${p}`;

const canonicalUrl = canonical ? abs(canonical) : abs(Astro.url.pathname);
const shareImage = abs(ogImage || defaultOg);

/**
 * Preview deploys (*.workers.dev) serve byte-identical content to production,
 * which is textbook duplicate content. Any host that is not the canonical one
 * is marked noindex automatically, so a preview can never compete with the real
 * site in the index. Canonical tags alone are a hint; this is not.
 */
const canonicalHost = new URL(siteUrl).host;
const isCanonicalHost = Astro.url.host === canonicalHost;
const blockIndexing = noindex || !isCanonicalHost;

// Resolve the share card once, so og:* and twitter:* cannot drift apart.
const shareTitle = ogTitle || title;
const shareDesc = ogDescription || description;
const xTitle = twitterTitle || shareTitle;
const xDesc = twitterDescription || shareDesc;
const xImage = twitterImage ? abs(twitterImage) : shareImage;

const ldArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog/', label: 'Writing' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonicalUrl} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={xTitle} />
    <meta name="twitter:description" content={xDesc} />
    <meta name="twitter:image" content={xImage} />

    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Writing`} href="/rss.xml" />

    {/* Self-hosted fonts: preload the two faces used above the fold. */}
    <link rel="preload" href="/assets/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Set the theme before first paint so there is no flash of the wrong one. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    {ldArray.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}

    {/*
      Google Analytics — same measurement ID and the same deferral trick as the
      previous site: gtag.js only loads on first interaction (or after 15s), so
      it stays off the critical path and out of the LCP measurement.
      The ID now comes from the settings table; blank disables analytics entirely.
    */}
    {gaId && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.google-analytics.com" />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
          (function () {
            var loaded = false;
            var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
            function loadGtag() {
              if (loaded) return;
              loaded = true;
              clearTimeout(fallback);
              events.forEach(function (evt) {
                window.removeEventListener(evt, loadGtag, { passive: true });
              });
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
              document.head.appendChild(s);
            }
            events.forEach(function (evt) {
              window.addEventListener(evt, loadGtag, { passive: true, once: true });
            });
            var fallback = setTimeout(loadGtag, 15000);
          })();
        </script>
      </>
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="wordmark" href="/" aria-label={`${siteName} — home`}>
          <span class="wordmark__name">Ibrahim</span>
          <span class="wordmark__rule" aria-hidden="true"></span>
          <span class="wordmark__last">Al-Bander</span>
        </a>

        <nav aria-label="Primary">
          <ul class="nav">
            {nav.map((item) => {
              const active =
                item.href === '/' ? path === '/' : path.startsWith(item.href.replace(/\/$/, ''));
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={['nav__link', { 'is-active': active }]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Switch between light and dark mode"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.2"></circle>
            <path
              d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p class="muted">Designed and built by {siteName}. Written by hand, in Erbil.</p>
        <p class="muted">&copy; {year}</p>
      </div>
    </footer>

    <script>
      // Theme toggle. Respects the OS setting until the reader overrides it.
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in oklab, var(--paper) 82%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: var(--rule) solid var(--rule-color);
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-m);
        min-height: 4rem;
      }

      /* The wordmark splits the name with a rule that draws itself on hover —
         a small piece of personality a component library would not give you. */
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 600;
        letter-spacing: var(--tracking-tight);
      }

      .wordmark__rule {
        display: block;
        width: 1.4rem;
        height: 1px;
        background: var(--accent);
        transition: width var(--dur-mid) var(--ease-out);
      }

      .wordmark:hover .wordmark__rule {
        width: 2.6rem;
      }

      .wordmark__last {
        color: var(--ink-3);
        transition: color var(--dur-mid) var(--ease-out);
      }

      .wordmark:hover .wordmark__last {
        color: var(--accent-ink);
      }

      .nav {
        display: flex;
        gap: clamp(0.75rem, 2.5vw, 1.75rem);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav__link {
        font-size: var(--step--1);
        text-decoration: none;
        color: var(--ink-2);
        position: relative;
        padding-block: 0.35rem;
        transition: color var(--dur-fast) var(--ease-out);
      }

      .nav__link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        height: 1px;
        width: 100%;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--dur-mid) var(--ease-out);
      }

      .nav__link:hover,
      .nav__link.is-active {
        color: var(--ink);
      }

      .nav__link:hover::after,
      .nav__link.is-active::after {
        transform: scaleX(1);
      }

      .theme-toggle {
        display: grid;
        place-items: center;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 999px;
        border: var(--rule) solid var(--rule-color);
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
        transition:
          color var(--dur-fast) var(--ease-out),
          border-color var(--dur-fast) var(--ease-out),
          transform var(--dur-mid) var(--ease-out);
      }

      .theme-toggle:hover {
        color: var(--accent-ink);
        border-color: var(--accent);
        transform: rotate(35deg);
      }

      .site-footer {
        border-top: var(--rule) solid var(--rule-color);
        margin-top: var(--space-2xl);
        padding-block: var(--space-l);
      }

      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-m);
        justify-content: space-between;
        font-size: var(--step--1);
      }

      .site-footer p {
        margin: 0;
      }
    </style>
  </body>
</html>
