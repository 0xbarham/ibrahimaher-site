---
/**
 * A social link rendered as a brand mark.
 *
 * Renders the whole anchor rather than just the glyph, deliberately: an
 * icon-only link with no accessible name is one of the easiest a11y failures to
 * ship, so the accessible name is not left to the call site. The `<svg>` is
 * always `aria-hidden` and the real name comes from the `.visually-hidden`
 * label, which means screen readers read "LinkedIn, link" and never "link".
 *
 * Paths are inlined (no icon font, no CDN, no external request — the CSP would
 * block one anyway) and drawn in `currentColor`, so the marks stay monochrome
 * and inherit the editorial palette instead of becoming a row of brand blobs.
 */
export type SocialName = 'linkedin' | 'facebook' | 'instagram' | 'telegram';

interface Props {
  name: SocialName;
  href: string;
  /** Accessible name. Also the tooltip. */
  label: string;
  /** Render the label as visible text beside the mark instead of hiding it. */
  showLabel?: boolean;
}

const { name, href, label, showLabel = false } = Astro.props;

/**
 * Official glyph outlines on a 24x24 box. Instagram is the outline mark rather
 * than the filled gradient tile — at 18px, monochrome, it is the only one of
 * the four that reads as a hairline drawing rather than a solid block, which is
 * what keeps the row quiet.
 */
const PATHS: Record<SocialName, string[]> = {
