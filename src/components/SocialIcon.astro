const paths = PATHS[name];
---

<a
  class="social"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  title={label}
  data-social={name}
>
  <span class="social__ring">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
      {paths.map((d) => <path d={d} />)}
    </svg>
  </span>
  <span class:list={[showLabel ? 'social__label' : 'visually-hidden']}>{label}</span>
</a>

<style>
  .social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    color: var(--ink-2);
    /* Only ever transform/colour — never a layout property. */
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* The hairline ring is the same gesture as the theme toggle in the header, so
     the marks read as part of the same drawn system rather than imported chrome. */
  .social__ring {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-pill);
    border: var(--rule) solid var(--rule-color);
    background: transparent;
    transition:
      color var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out),
      background-color var(--dur-mid) var(--ease-out),
      transform var(--dur-mid) var(--ease-settle);
  }

  .social:hover,
  .social:focus-visible {
    color: var(--accent-ink);
  }

  .social:hover .social__ring,
  .social:focus-visible .social__ring {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .social:active .social__ring {
    transform: translateY(0);
  }

  .social__label {
    font-size: var(--step--1);
  }

  /* The ring carries the focus ring; without this the outline wraps the whole
     inline-flex including the hidden label and looks broken. */
  .social:focus-visible {
    outline: none;
  }

  .social:focus-visible .social__ring {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
