---
/**
 * Posts list — every post, drafts included.
 *
 * Rendered fully server-side: the list is the whole point of the page, so it
 * must not depend on JS. Search only filters rows that are already in the DOM.
 */
import Admin from '../../../layouts/Admin.astro';
import { getAllPosts } from '../../../lib/db';
import type { Author } from '../../../lib/db';
import { db } from '../../../lib/db';

const posts = await getAllPosts();

// One query for all authors beats getAuthor() per row (a classic N+1).
const { results: authorRows } = await db()
  .prepare('SELECT * FROM authors')
  .all<Author>();
const authors = new Map((authorRows ?? []).map((a) => [a.id, a.name]));

const total = posts.length;
const drafts = posts.filter((p) => p.status !== 'published').length;
---

<Admin title="Posts" section="posts">
  <a slot="header-actions" class="btn btn--primary btn--sm" href="/admin/posts/new">New post</a>

  <div class="stack">
    <div class="cluster">
      <div class="field" style="max-width: 18rem; flex: 1;">
        <label class="visually-hidden" for="post-search">Search posts</label>
        <input
          class="input"
          type="search"
          id="post-search"
          placeholder="Filter by title, slug or category…"
          autocomplete="off"
        />
      </div>

      <div class="field" style="max-width: 10rem;">
        <label class="visually-hidden" for="status-filter">Filter by status</label>
        <select class="select" id="status-filter">
          <option value="">All statuses</option>
          <option value="published">Published</option>
          <option value="scheduled">Scheduled</option>
          <option value="draft">Drafts</option>
        </select>
      </div>

      <p class="muted" id="result-count" role="status" aria-live="polite" style="margin-left:auto;">
        {total} {total === 1 ? 'post' : 'posts'}{drafts > 0 ? `, ${drafts} draft${drafts === 1 ? '' : 's'}` : ''}
      </p>
    </div>

    <p class="status" id="list-status" role="status" aria-live="polite"></p>

    {/*
      Bulk bar. Hidden until something is selected rather than always-present-
      but-disabled: a permanently visible toolbar of dead buttons is noise on
      every visit, and the selection state is what makes the actions meaningful.
      aria-live announces the count so it is not a purely visual change.
    */}
    <div class="bulkbar" id="bulk-bar" hidden>
      <p class="bulkbar__count" role="status" aria-live="polite">
        <span id="bulk-count">0</span> selected
      </p>
      <div class="cluster">
        <button class="btn btn--sm" type="button" data-bulk="published">Publish</button>
        <button class="btn btn--sm" type="button" data-bulk="draft">Move to drafts</button>
        <button class="btn btn--sm btn--danger" type="button" data-bulk="delete">Delete</button>
        <button class="btn btn--sm" type="button" id="bulk-clear">Clear</button>
      </div>
    </div>

    {
      total === 0 ? (
        <div class="card">
          <p class="muted">
            No posts yet. <a href="/admin/posts/new">Write the first one</a>.
          </p>
        </div>
      ) : (
        <div class="table-wrap">
          <table class="table" id="posts-table">
            <thead>
              <tr>
                <th scope="col" class="table__check">
                  <input
                    type="checkbox"
                    id="select-all"
                    aria-label="Select all visible posts"
                  />
                </th>
                <th scope="col">Title</th>
                <th scope="col">Status</th>
                <th scope="col">Category</th>
                <th scope="col">Date</th>
                <th scope="col">Author</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {posts.map((p) => (
                <tr
                  data-row
                  data-id={p.id}
                  data-status={
                    p.status === 'published'
                      ? 'published'
                      : p.status === 'scheduled'
                        ? 'scheduled'
                        : 'draft'
                  }
                  data-search={`${p.title} ${p.slug} ${p.category}`.toLowerCase()}
                >
                  <td class="table__check">
                    <input
                      type="checkbox"
                      data-select
                      value={p.id}
                      aria-label={`Select ${p.title || 'untitled post'}`}
                    />
                  </td>
                  <td>
                    <a class="table__title" href={`/admin/posts/${p.id}`}>
                      {p.title || '(untitled)'}
                    </a>
                    <div class="muted" style="font-family: var(--font-mono); font-size: 0.72rem;">
                      /{p.slug}
                    </div>
                  </td>
                  <td>
                    {/*
                      Three states, not two. A scheduled post is neither live nor
                      abandoned, and collapsing it into "Draft" is how one sits
                      queued for a week without anyone noticing it never went out.
                      The publish time is shown inline because "scheduled" without
                      "when" is not actionable.
                    */}
                    <span
                      class={`badge badge--${
                        p.status === 'published'
                          ? 'published'
                          : p.status === 'scheduled'
                            ? 'scheduled'
                            : 'draft'
                      }`}
                    >
                      <span class="badge__dot" aria-hidden="true" />
                      {p.status === 'published'
                        ? 'Published'
                        : p.status === 'scheduled'
                          ? 'Scheduled'
                          : 'Draft'}
                    </span>
                    {p.status === 'scheduled' && p.publish_at && (
                      <div class="muted" style="font-family: var(--font-mono); font-size: 0.68rem;">
                        {p.publish_at.replace('T', ' ').replace('Z', ' UTC')}
                      </div>
                    )}
                  </td>
                  <td data-empty={!p.category}>{p.category || '—'}</td>
                  <td class="muted" style="white-space: nowrap;">{p.post_date || '—'}</td>
                  <td data-empty={!authors.get(p.author_id)}>
                    {authors.get(p.author_id) || '—'}
                  </td>
                  <td>
                    <div class="table__actions">
                      <a class="btn btn--sm" href={`/admin/posts/${p.id}`}>
                        Edit
                      </a>
                      {/*
                        This used to be a link that knowingly 404'd for drafts,
                        with a title attribute explaining why. Now that
                        /blog/<slug>?preview=1 renders any status behind an admin
                        session, an unpublished post opens in the real layout
                        instead — which is what someone clicking "View" on a draft
                        was always trying to do.
                      */}
                      <a
                        class="btn btn--sm"
                        href={
                          p.status === 'published' ? `/blog/${p.slug}` : `/blog/${p.slug}?preview=1`
                        }
                        target="_blank"
                        rel="noopener"
                        title={
                          p.status === 'published'
                            ? 'Open the live post in a new tab'
                            : 'Preview this unpublished post in the real layout'
                        }
                      >
                        {p.status === 'published' ? 'View ↗' : 'Preview ↗'}
                      </a>
                      <button
                        class="btn btn--sm"
                        type="button"
                        data-duplicate
                        data-id={p.id}
                        data-title={p.title || '(untitled)'}
                        title="Create a draft copy of this post"
                      >
                        Duplicate
                      </button>
                      <button
                        class="btn btn--sm btn--danger"
                        type="button"
                        data-delete
                        data-id={p.id}
                        data-title={p.title || '(untitled)'}
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
              <tr id="no-results" hidden>
                <td colspan="7" class="muted" style="text-align:center; padding: var(--space-m);">
                  No posts match that filter.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      )
    }

    <p class="muted" style="font-size: 0.72rem;">
      Drafts and scheduled posts are not public — they return 404 to anyone else until they go
      live. <strong>Preview</strong> opens them in the real layout for you only. A scheduled post
      publishes itself on the first visit after its time.
    </p>
  </div>
</Admin>

<script>
  const search = document.getElementById('post-search') as HTMLInputElement | null;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement | null;
  const count = document.getElementById('result-count');
  const noResults = document.getElementById('no-results');
  const status = document.getElementById('list-status');

  const rows = () =>
    Array.from(document.querySelectorAll<HTMLTableRowElement>('tr[data-row]'));

  function setStatus(msg: string, kind?: 'ok' | 'err' | 'busy') {
    if (!status) return;
    status.textContent = msg;
    status.className = 'status' + (kind ? ` status--${kind}` : '');
  }

  // --- Filtering --------------------------------------------------------
  function applyFilter() {
    const q = (search?.value || '').trim().toLowerCase();
    const want = statusFilter?.value || '';
    let visible = 0;

    for (const row of rows()) {
      const matchesQ = !q || (row.dataset.search || '').includes(q);
      const matchesS = !want || row.dataset.status === want;
      const show = matchesQ && matchesS;
      row.hidden = !show;
      if (show) visible++;
    }

    if (noResults) noResults.hidden = visible !== 0;
    if (count) count.textContent = `${visible} ${visible === 1 ? 'post' : 'posts'}`;
  }

  search?.addEventListener('input', () => {
    applyFilter();
    syncSelection();
  });
  statusFilter?.addEventListener('change', () => {
    applyFilter();
    syncSelection();
  });

  // --- Selection and bulk actions ---------------------------------------
  const bulkBar = document.getElementById('bulk-bar');
  const bulkCount = document.getElementById('bulk-count');
  const selectAll = document.getElementById('select-all') as HTMLInputElement | null;

  const boxes = () =>
    Array.from(document.querySelectorAll<HTMLInputElement>('input[data-select]'));

  /** Checkboxes on rows the filter is currently showing. */
  const visibleBoxes = () => boxes().filter((b) => !b.closest('tr')?.hidden);

  const selectedIds = () =>
    visibleBoxes()
      .filter((b) => b.checked)
      .map((b) => Number(b.value));

  /**
   * Keep the selection honest.
   *
   * A row hidden by the filter is deselected, because acting on rows you cannot
   * see is the classic bulk-action accident: search for "draft", select all,
   * clear the search, hit delete, and take the whole table with you. Selection
   * is therefore only ever what is on screen.
   */
  function syncSelection() {
    for (const b of boxes()) {
      if (b.closest('tr')?.hidden) b.checked = false;
    }

    const n = selectedIds().length;
    const vis = visibleBoxes();

    if (bulkCount) bulkCount.textContent = String(n);
    if (bulkBar) bulkBar.hidden = n === 0;

    if (selectAll) {
      selectAll.checked = n > 0 && n === vis.length;
      // Distinct from both checked and unchecked: some-but-not-all.
      selectAll.indeterminate = n > 0 && n < vis.length;
    }
  }

  selectAll?.addEventListener('change', () => {
    for (const b of visibleBoxes()) b.checked = selectAll.checked;
    syncSelection();
  });

  document.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).matches?.('input[data-select]')) syncSelection();
  });

  document.getElementById('bulk-clear')?.addEventListener('click', () => {
    for (const b of boxes()) b.checked = false;
    syncSelection();
  });

  async function runBulk(action: 'status' | 'delete', status_?: string) {
    const ids = selectedIds();
    if (ids.length === 0) return;

    setStatus(action === 'delete' ? 'Deleting…' : 'Updating…', 'busy');
    try {
      const res = await fetch('/api/posts/bulk', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(
          action === 'delete' ? { action: 'delete', ids } : { action: 'status', ids, status: status_ }
        ),
      });

      if (res.status === 401) {
        setStatus('Your session expired. Log in again to continue.', 'err');
        showLoginLink();
        return;
      }

      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; changed?: number };
      if (!res.ok || !data.ok) throw new Error(data.error || `Failed (${res.status})`);

      /*
       * Reload rather than patching the DOM.
       *
       * A bulk status change alters the badge, the scheduled timestamp, the
       * counts in the header, and which rows the current filter should show.
       * Reconstructing all of that by hand is how an admin list drifts out of
       * sync with the database it claims to be showing; the page is
       * server-rendered and cheap, so re-rendering it is both simpler and
       * guaranteed correct.
       */
      location.reload();
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Bulk action failed.', 'err');
    }
  }

  /*
   * Bulk delete arms itself before firing.
   *
   * This page deliberately avoids window.confirm() — a native modal is
   * unstyleable, blocks the whole tab, and reads as a browser error rather than
   * as part of the tool. The per-row delete already uses an inline confirm, so
   * the bulk button does the same thing in the space it has: the first click
   * turns it into "Confirm delete (3)", the second one commits, and anything
   * else disarms it.
   */
  let armedDelete = false;

  function disarmDelete() {
    const btn = document.querySelector<HTMLButtonElement>('[data-bulk="delete"]');
    if (!btn) return;
    armedDelete = false;
    btn.textContent = 'Delete';
    btn.classList.remove('is-armed');
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-bulk]')) {
    btn.addEventListener('click', () => {
      const action = btn.dataset.bulk!;
      const n = selectedIds().length;
      if (n === 0) return;

      if (action !== 'delete') {
        disarmDelete();
        void runBulk('status', action);
        return;
      }

      if (!armedDelete) {
        armedDelete = true;
        btn.textContent = `Confirm delete (${n})`;
        btn.classList.add('is-armed');
        return;
      }

      disarmDelete();
      void runBulk('delete');
    });
  }

  // Changing the selection invalidates an armed delete — the count on the
  // button would otherwise be a lie about what is about to be removed.
  document.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).matches?.('input[data-select], #select-all')) disarmDelete();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') disarmDelete();
  });

  // --- Delete, with an inline confirm (never a bare link, never confirm()) --
  let openConfirm: HTMLElement | null = null;

  function closeConfirm() {
    if (!openConfirm) return;
    const btn = openConfirm.previousElementSibling as HTMLElement | null;
    openConfirm.remove();
    openConfirm = null;
    btn?.focus();
  }

  async function doDelete(id: string, row: HTMLTableRowElement) {
    setStatus('Deleting…', 'busy');
    try {
      const res = await fetch(`/api/content/posts?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
      });

      if (res.status === 401) {
        setStatus('Your session expired. Log in again to continue.', 'err');
        showLoginLink();
        return;
      }

      const data = await res.json().catch(() => ({}) as { ok?: boolean; error?: string });
      if (!res.ok || !data.ok) throw new Error(data.error || `Delete failed (${res.status})`);

      row.remove();
      setStatus('Post deleted.', 'ok');
      applyFilter();
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Delete failed.', 'err');
    }
  }

  function showLoginLink() {
    if (!status || status.querySelector('a')) return;
    const a = document.createElement('a');
    a.href = `/admin/login?next=${encodeURIComponent(location.pathname)}`;
    a.textContent = 'Log in';
    status.append(' ', a);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    /*
     * Duplicate. Lands the user in the copy's editor rather than back on the
     * list: the only reason to duplicate a post is to start changing it, and
     * bouncing to a list where the new row is titled "… (copy)" just adds a
     * click to every use of the feature.
     */
    const dup = target.closest<HTMLButtonElement>('[data-duplicate]');
    if (dup) {
      const id = Number(dup.dataset.id);
      dup.disabled = true;
      setStatus(`Duplicating “${dup.dataset.title}”…`, 'busy');

      void (async () => {
        try {
          const res = await fetch('/api/posts/bulk', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: 'duplicate', id }),
          });

          if (res.status === 401) {
            setStatus('Your session expired. Log in again to continue.', 'err');
            showLoginLink();
            return;
          }

          const data = (await res.json().catch(() => ({}))) as {
            ok?: boolean;
            error?: string;
            id?: number;
          };
          if (!res.ok || !data.ok || !data.id) {
            throw new Error(data.error || `Duplicate failed (${res.status})`);
          }

          location.href = `/admin/posts/${data.id}`;
        } catch (err) {
          setStatus(err instanceof Error ? err.message : 'Duplicate failed.', 'err');
        } finally {
          dup.disabled = false;
        }
      })();
      return;
    }

    const trigger = target.closest<HTMLButtonElement>('[data-delete]');
    if (trigger) {
      closeConfirm();
      const row = trigger.closest('tr') as HTMLTableRowElement;
      const id = trigger.dataset.id!;

      const box = document.createElement('span');
      box.className = 'confirm';
      box.innerHTML = '<span class="confirm__text"></span>';
      // textContent, not innerHTML: the title is a DB value.
      box.querySelector('.confirm__text')!.textContent = 'Delete permanently?';

      const yes = document.createElement('button');
      yes.type = 'button';
      yes.className = 'btn btn--sm btn--danger';
      yes.textContent = 'Delete';
      yes.addEventListener('click', () => {
        box.remove();
        openConfirm = null;
        void doDelete(id, row);
      });

      const no = document.createElement('button');
      no.type = 'button';
      no.className = 'btn btn--sm';
      no.textContent = 'Cancel';
      no.addEventListener('click', closeConfirm);

      box.append(yes, no);
      trigger.after(box);
      openConfirm = box;
      yes.focus();
      return;
    }

    if (openConfirm && !target.closest('.confirm')) closeConfirm();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && openConfirm) {
      e.stopPropagation();
      closeConfirm();
    }
  });
</script>
