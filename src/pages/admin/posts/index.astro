---
/**
 * Posts list — every post, drafts included.
 *
 * Rendered fully server-side: the list is the whole point of the page, so it
 * must not depend on JS. Search only filters rows that are already in the DOM.
 */
import Admin from '../../../layouts/Admin.astro';
import { getAllPosts } from '../../../lib/db';
import type { Author } from '../../../lib/db';
import { db } from '../../../lib/db';

const posts = await getAllPosts();

// One query for all authors beats getAuthor() per row (a classic N+1).
const { results: authorRows } = await db()
  .prepare('SELECT * FROM authors')
  .all<Author>();
const authors = new Map((authorRows ?? []).map((a) => [a.id, a.name]));

const total = posts.length;
const drafts = posts.filter((p) => p.status !== 'published').length;
---

<Admin title="Posts" section="posts">
  <a slot="header-actions" class="btn btn--primary btn--sm" href="/admin/posts/new">New post</a>

  <div class="stack">
    <div class="cluster">
      <div class="field" style="max-width: 18rem; flex: 1;">
        <label class="visually-hidden" for="post-search">Search posts</label>
        <input
          class="input"
          type="search"
          id="post-search"
          placeholder="Filter by title, slug or category…"
          autocomplete="off"
        />
      </div>

      <div class="field" style="max-width: 10rem;">
        <label class="visually-hidden" for="status-filter">Filter by status</label>
        <select class="select" id="status-filter">
          <option value="">All statuses</option>
          <option value="published">Published</option>
          <option value="draft">Drafts</option>
        </select>
      </div>

      <p class="muted" id="result-count" role="status" aria-live="polite" style="margin-left:auto;">
        {total} {total === 1 ? 'post' : 'posts'}{drafts > 0 ? `, ${drafts} draft${drafts === 1 ? '' : 's'}` : ''}
      </p>
    </div>

    <p class="status" id="list-status" role="status" aria-live="polite"></p>

    {
      total === 0 ? (
        <div class="card">
          <p class="muted">
            No posts yet. <a href="/admin/posts/new">Write the first one</a>.
          </p>
        </div>
      ) : (
        <div class="table-wrap">
          <table class="table" id="posts-table">
            <thead>
              <tr>
                <th scope="col">Title</th>
                <th scope="col">Status</th>
                <th scope="col">Category</th>
                <th scope="col">Date</th>
                <th scope="col">Author</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {posts.map((p) => (
                <tr
                  data-row
                  data-id={p.id}
                  data-status={p.status === 'published' ? 'published' : 'draft'}
                  data-search={`${p.title} ${p.slug} ${p.category}`.toLowerCase()}
                >
                  <td>
                    <a class="table__title" href={`/admin/posts/${p.id}`}>
                      {p.title || '(untitled)'}
                    </a>
                    <div class="muted" style="font-family: var(--font-mono); font-size: 0.72rem;">
                      /{p.slug}
                    </div>
                  </td>
                  <td>
                    <span class={`badge badge--${p.status === 'published' ? 'published' : 'draft'}`}>
                      <span class="badge__dot" aria-hidden="true" />
                      {p.status === 'published' ? 'Published' : 'Draft'}
                    </span>
                  </td>
                  <td data-empty={!p.category}>{p.category || '—'}</td>
                  <td class="muted" style="white-space: nowrap;">{p.post_date || '—'}</td>
                  <td data-empty={!authors.get(p.author_id)}>
                    {authors.get(p.author_id) || '—'}
                  </td>
                  <td>
                    <div class="table__actions">
                      <a class="btn btn--sm" href={`/admin/posts/${p.id}`}>
                        Edit
                      </a>
                      {/*
                        Drafts 404 on the public site by design — getPostBySlug()
                        filters on status. Opening one is still the fastest way to
                        confirm that, so the link stays and the title says so.
                      */}
                      <a
                        class="btn btn--sm"
                        href={`/blog/${p.slug}`}
                        target="_blank"
                        rel="noopener"
                        title={
                          p.status === 'published'
                            ? 'Open the live post in a new tab'
                            : 'Drafts are not public — this will 404 until published'
                        }
                      >
                        View{p.status !== 'published' ? ' ↗*' : ' ↗'}
                      </a>
                      <button
                        class="btn btn--sm btn--danger"
                        type="button"
                        data-delete
                        data-id={p.id}
                        data-title={p.title || '(untitled)'}
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
              <tr id="no-results" hidden>
                <td colspan="6" class="muted" style="text-align:center; padding: var(--space-m);">
                  No posts match that filter.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      )
    }

    <p class="muted" style="font-size: 0.72rem;">
      * Draft posts are not published to the live site and will return 404 until their status is
      set to published.
    </p>
  </div>
</Admin>

<script>
  const search = document.getElementById('post-search') as HTMLInputElement | null;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement | null;
  const count = document.getElementById('result-count');
  const noResults = document.getElementById('no-results');
  const status = document.getElementById('list-status');

  const rows = () =>
    Array.from(document.querySelectorAll<HTMLTableRowElement>('tr[data-row]'));

  function setStatus(msg: string, kind?: 'ok' | 'err' | 'busy') {
    if (!status) return;
    status.textContent = msg;
    status.className = 'status' + (kind ? ` status--${kind}` : '');
  }

  // --- Filtering --------------------------------------------------------
  function applyFilter() {
    const q = (search?.value || '').trim().toLowerCase();
    const want = statusFilter?.value || '';
    let visible = 0;

    for (const row of rows()) {
      const matchesQ = !q || (row.dataset.search || '').includes(q);
      const matchesS = !want || row.dataset.status === want;
      const show = matchesQ && matchesS;
      row.hidden = !show;
      if (show) visible++;
    }

    if (noResults) noResults.hidden = visible !== 0;
    if (count) count.textContent = `${visible} ${visible === 1 ? 'post' : 'posts'}`;
  }

  search?.addEventListener('input', applyFilter);
  statusFilter?.addEventListener('change', applyFilter);

  // --- Delete, with an inline confirm (never a bare link, never confirm()) --
  let openConfirm: HTMLElement | null = null;

  function closeConfirm() {
    if (!openConfirm) return;
    const btn = openConfirm.previousElementSibling as HTMLElement | null;
    openConfirm.remove();
    openConfirm = null;
    btn?.focus();
  }

  async function doDelete(id: string, row: HTMLTableRowElement) {
    setStatus('Deleting…', 'busy');
    try {
      const res = await fetch(`/api/content/posts?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
      });

      if (res.status === 401) {
        setStatus('Your session expired. Log in again to continue.', 'err');
        showLoginLink();
        return;
      }

      const data = await res.json().catch(() => ({}) as { ok?: boolean; error?: string });
      if (!res.ok || !data.ok) throw new Error(data.error || `Delete failed (${res.status})`);

      row.remove();
      setStatus('Post deleted.', 'ok');
      applyFilter();
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Delete failed.', 'err');
    }
  }

  function showLoginLink() {
    if (!status || status.querySelector('a')) return;
    const a = document.createElement('a');
    a.href = `/admin/login?next=${encodeURIComponent(location.pathname)}`;
    a.textContent = 'Log in';
    status.append(' ', a);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const trigger = target.closest<HTMLButtonElement>('[data-delete]');
    if (trigger) {
      closeConfirm();
      const row = trigger.closest('tr') as HTMLTableRowElement;
      const id = trigger.dataset.id!;

      const box = document.createElement('span');
      box.className = 'confirm';
      box.innerHTML = '<span class="confirm__text"></span>';
      // textContent, not innerHTML: the title is a DB value.
      box.querySelector('.confirm__text')!.textContent = 'Delete permanently?';

      const yes = document.createElement('button');
      yes.type = 'button';
      yes.className = 'btn btn--sm btn--danger';
      yes.textContent = 'Delete';
      yes.addEventListener('click', () => {
        box.remove();
        openConfirm = null;
        void doDelete(id, row);
      });

      const no = document.createElement('button');
      no.type = 'button';
      no.className = 'btn btn--sm';
      no.textContent = 'Cancel';
      no.addEventListener('click', closeConfirm);

      box.append(yes, no);
      trigger.after(box);
      openConfirm = box;
      yes.focus();
      return;
    }

    if (openConfirm && !target.closest('.confirm')) closeConfirm();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && openConfirm) {
      e.stopPropagation();
      closeConfirm();
    }
  });
</script>
