---
/**
 * Generic row editor for the simple content tables.
 *
 * The field list is still bounded by TABLE_COLUMNS, the same allowlist the API
 * validates against — so the form can never offer a column the API will reject.
 * What each column LOOKS like now comes from CONTENT_FIELDS in schema.ts.
 */
import Admin from '../../../layouts/Admin.astro';
import { columnsFor, contentFieldsFor, isTable } from '../../../lib/schema';

const { table } = Astro.params;

// Only the CV-ish tables belong here. posts has its own editor; authors,
// redirects and media are not part of this page's remit, so they are rejected
// rather than half-rendered.
const ALLOWED = ['jobs', 'projects', 'skills', 'certifications', 'education'];

if (!table || !isTable(table) || !ALLOWED.includes(table)) {
  return Astro.rewrite('/404');
}

const columns = columnsFor(table);
const label = table.charAt(0).toUpperCase() + table.slice(1);

/*
 * Controls come from CONTENT_FIELDS in schema.ts — the same per-column metadata
 * shape POST_FIELDS gives the post editor. It replaced a `kindOf(col)` that
 * guessed the control from the column NAME, which is how `hidden` ended up as a
 * text box and quietly deleted a project from the live site. Nothing about the
 * field list is decided here any more; only the *behaviour* of each `kind` is,
 * exactly as in admin/posts/[id].astro.
 */
const fieldMeta = contentFieldsFor(table);

/**
 * Sections, in order. These mirror the post editor's tabs, except a row is
 * short enough that stacking the sections beats hiding three quarters of them
 * behind tabs — a project has 14 columns, not 30.
 *
 * A described field with no group falls back to Basics; an undescribed column
 * gets the last section, which is named to be alarming because it is.
 */
const GROUPS = [
  { key: 'basics', label: 'Basics' },
  { key: 'media', label: 'Images' },
  { key: 'link', label: 'Link' },
  { key: 'placement', label: 'Placement' },
] as const;

const sections = [
  ...GROUPS.map((g) => ({
    key: g.key as string,
    label: g.label as string,
    fields: fieldMeta.filter((f) => !f.unspecified && (f.group ?? 'basics') === g.key),
  })),
  { key: 'unknown', label: 'Not editable', fields: fieldMeta.filter((f) => f.unspecified) },
].filter((s) => s.fields.length > 0);

// One section is not a grouping, it is a heading over the whole card — noise.
const showLegends = sections.length > 1;

/** The column that best identifies a row in its collapsed header. */
const titleCol = columns.includes('title') ? 'title' : columns.includes('category') ? 'category' : columns[1];
---

<Admin title={label} section="content" table={table}>
  <button slot="header-actions" class="btn btn--primary btn--sm" id="add-row" type="button">
    Add {label.replace(/s$/, '')}
  </button>

  <div class="stack">
    <div class="cluster">
      <p class="muted" style="margin:0;">
        Rows are ordered by <code>sort_order</code> (low to high). Use the arrows to reorder — that
        swaps the two rows' sort values and saves both.
      </p>
      <p class="status" id="page-status" role="status" aria-live="polite" style="margin-left:auto;">
      </p>
    </div>

    <div id="rows" class="stack" aria-busy="true">
      <p class="muted" id="loading">Loading {table}…</p>
    </div>
  </div>
</Admin>

<script define:vars={{ table, sections, titleCol, showLegends }}>
  window.__TABLE__ = { table, sections, titleCol, showLegends };
</script>

<script>
  import { buildImageControl } from '../../../lib/schema';
  import type { ContentField } from '../../../lib/schema';

  const CFG = (window as any).__TABLE__ as {
    table: string;
    sections: { key: string; label: string; fields: ContentField[] }[];
    titleCol: string;
    showLegends: boolean;
  };

  /** Sections are for layout; validation and seeding want the flat list. */
  const allFields = CFG.sections.flatMap((s) => s.fields);

  const rowsEl = document.getElementById('rows')!;
  const statusEl = document.getElementById('page-status')!;
  let rows: Record<string, any>[] = [];

  let statusTimer: number | undefined;
  function setStatus(msg: string, kind?: 'ok' | 'err' | 'busy', sticky = false) {
    window.clearTimeout(statusTimer);
    statusEl.textContent = msg;
    statusEl.className = 'status' + (kind ? ` status--${kind}` : '');
    if (msg && !sticky) {
      statusTimer = window.setTimeout(() => {
        if (statusEl.textContent === msg) setStatus('');
      }, 4000);
    }
  }

  function sessionExpired() {
    setStatus('Session expired. ', 'err', true);
    const a = document.createElement('a');
    a.href = `/admin/login?next=${encodeURIComponent(location.pathname)}`;
    a.textContent = 'Log in again';
    statusEl.append(a);
  }

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(path, {
      ...options,
      headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
    });
    if (res.status === 401) {
      sessionExpired();
      throw new Error('Not authenticated');
    }
    const data = await res.json().catch(() => ({}) as any);
    if (!res.ok || !data.ok) throw new Error(data.error || `Request failed (${res.status})`);
    return data;
  }

  function parseTags(json: string): string[] {
    if (!json) return [];
    try {
      const p = JSON.parse(json);
      return Array.isArray(p) ? p.filter((t) => typeof t === 'string') : [];
    } catch {
      return json.split(',').map((s) => s.trim()).filter(Boolean);
    }
  }

  // --- Tag input --------------------------------------------------------
  function tagInput(name: string, initial: string, onChange: () => void) {
    const wrap = document.createElement('div');
    wrap.className = 'tags';

    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.dataset.field = name;
    hidden.dataset.kind = 'tags';
    hidden.value = initial || '[]';

    const input = document.createElement('input');
    input.className = 'tags__input';
    input.type = 'text';
    input.placeholder = 'Add a tag…';
    input.autocomplete = 'off';

    let tags = parseTags(initial);

    function sync() {
      hidden.value = JSON.stringify(tags);
      onChange();
    }

    function render() {
      wrap.querySelectorAll('.tag').forEach((n) => n.remove());
      tags.forEach((tag, i) => {
        const el = document.createElement('span');
        el.className = 'tag';
        const t = document.createElement('span');
        t.className = 'tag__text';
        t.textContent = tag; // DB value
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'tag__x';
        x.setAttribute('aria-label', `Remove tag ${tag}`);
        x.textContent = '×';
        x.addEventListener('click', () => {
          tags.splice(i, 1);
          render();
          sync();
          input.focus();
        });
        el.append(t, x);
        wrap.insertBefore(el, input);
      });
    }

    function add(raw: string) {
      raw.split(',').map((s) => s.trim()).filter(Boolean).forEach((t) => {
        if (!tags.includes(t)) tags.push(t);
      });
      input.value = '';
      render();
      sync();
    }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        if (input.value.trim()) add(input.value);
      } else if (e.key === 'Backspace' && !input.value && tags.length) {
        tags.pop();
        render();
        sync();
      }
    });
    input.addEventListener('blur', () => input.value.trim() && add(input.value));

    wrap.append(input);
    render();

    const holder = document.createElement('div');
    holder.append(wrap, hidden);
    return holder;
  }

  // --- Field rendering --------------------------------------------------
  function hintEl(text: string, css = ''): HTMLElement {
    const p = document.createElement('p');
    p.className = 'field__hint';
    p.textContent = text;
    if (css) p.style.cssText = css;
    return p;
  }

  /**
   * Marks a control the save gate will refuse, and clears the mark the moment
   * the reader does something about it — a field that stays red while you type
   * into it is just shouting.
   */
  function markRequired(el: HTMLElement, f: ContentField) {
    if (!f.required) return;
    el.setAttribute('aria-required', 'true');
    el.addEventListener('input', () => el.removeAttribute('aria-invalid'));
  }

  /**
   * A column TABLE_COLUMNS allows but CONTENT_FIELDS does not describe safely.
   *
   * Read-only, and with no `data-field`, so collect() cannot see it and the API
   * never receives it — PUT only writes the columns present in the body, so the
   * stored value survives untouched. That is the entire point: the previous
   * behaviour was a friendly text box that seeded '' into an INTEGER column and
   * took a project off the live site without a word.
   */
  function unspecifiedField(f: ContentField, uid: string, raw: unknown): HTMLElement {
    const field = document.createElement('div');
    field.className = 'field field--wide';

    const lab = document.createElement('label');
    lab.className = 'field__label';
    lab.htmlFor = uid;
    lab.textContent = f.label;
    field.append(lab);

    const i = document.createElement('input');
    i.className = 'input input--mono';
    i.id = uid;
    i.type = 'text';
    i.value = raw === null || raw === undefined ? '' : String(raw);
    i.readOnly = true;
    field.append(i);

    const warn = document.createElement('div');
    warn.className = 'warn-box';
    const s = document.createElement('span');
    const strong = document.createElement('strong');
    strong.textContent = 'No field metadata:';
    const code = document.createElement('code');
    code.textContent = f.name;
    s.append(
      strong,
      document.createTextNode(' '),
      code,
      document.createTextNode(
        ' is an allowed column, but CONTENT_FIELDS in src/lib/schema.ts does not describe it — or ' +
          'describes an INTEGER column with a control that can produce an empty string. It is shown ' +
          'read-only and is not sent when you save. Add it to CONTENT_FIELDS to edit it.'
      )
    );
    warn.append(s);
    field.append(warn);
    return field;
  }

  function buildField(
    f: ContentField,
    row: Record<string, any>,
    uid: string,
    markDirty: () => void,
    onTitle: (v: string) => void
  ): HTMLElement {
    const raw = row[f.name] ?? '';

    if (f.unspecified) return unspecifiedField(f, uid, row[f.name]);

    const field = document.createElement('div');
    field.className = 'field';

    if (f.kind === 'boolean') {
      field.className = 'field field--check';
      const input = document.createElement('input');
      input.className = 'checkbox';
      input.type = 'checkbox';
      input.id = uid;
      input.dataset.field = f.name;
      input.dataset.kind = 'boolean';
      input.checked = Number(row[f.name]) === 1;
      input.addEventListener('change', markDirty);
      const lab = document.createElement('label');
      lab.className = 'field__label';
      lab.htmlFor = uid;
      lab.textContent = f.label;
      field.append(input, lab);
      if (f.hint) field.append(hintEl(f.hint, 'flex-basis:100%;'));
      return field;
    }

    const lab = document.createElement('label');
    lab.className = 'field__label';
    lab.htmlFor = uid;
    lab.textContent = f.label;
    if (f.required) {
      const req = document.createElement('span');
      req.className = 'field__req';
      req.textContent = 'Required';
      lab.append(req);
    }
    field.append(lab);
    if (f.hint) field.append(hintEl(f.hint));

    if (f.kind === 'tags') {
      field.className = 'field field--wide';
      const holder = tagInput(f.name, String(raw || '[]'), markDirty);
      holder.querySelector<HTMLInputElement>('.tags__input')!.id = uid;
      field.append(holder);
      return field;
    }

    if (f.kind === 'html' || f.kind === 'textarea') {
      field.className = 'field field--wide';
      const t = document.createElement('textarea');
      t.className = f.kind === 'html' ? 'textarea textarea--mono' : 'textarea';
      t.id = uid;
      t.rows = f.rows ?? 4;
      t.dataset.field = f.name;
      t.dataset.kind = f.kind;
      t.value = String(raw);
      t.addEventListener('input', markDirty);
      markRequired(t, f);
      field.append(t);
      return field;
    }

    if (f.kind === 'image') {
      const media = buildImageControl({
        id: uid,
        value: String(raw),
        field: f.name,
        label: f.label,
      });
      media.input.addEventListener('input', markDirty);
      markRequired(media.input, f);
      field.append(media.el);
      return field;
    }

    const i = document.createElement('input');
    i.className = 'input';
    i.id = uid;
    i.type =
      f.kind === 'number' ? 'number' : f.kind === 'url' ? 'url' : f.kind === 'date' ? 'date' : 'text';
    if (f.kind === 'number') i.inputMode = 'numeric';
    i.dataset.field = f.name;
    i.dataset.kind = f.kind;
    i.value = String(raw);
    markRequired(i, f);
    i.addEventListener('input', () => {
      markDirty();
      if (f.name === CFG.titleCol) onTitle(i.value);
    });
    field.append(i);
    return field;
  }

  // --- Row rendering ----------------------------------------------------
  function buildRow(row: Record<string, any>, isNew = false): HTMLElement {
    const card = document.createElement('section');
    card.className = 'row' + (isNew ? ' row--new' : '');
    card.dataset.id = row.id ?? '';
    if (isNew) card.dataset.new = 'true';

    const markDirty = () => {
      card.classList.add('row--dirty');
      const save = card.querySelector<HTMLButtonElement>('[data-save]');
      if (save) save.disabled = false;
    };

    // Head
    const head = document.createElement('div');
    head.className = 'row__head';

    const handle = document.createElement('span');
    handle.className = 'row__handle';
    handle.textContent = isNew ? 'new' : `#${row.id}`;

    const name = document.createElement('span');
    name.className = 'row__name';
    name.textContent = row[CFG.titleCol] || (isNew ? 'New row' : '(untitled)');

    const spacer = document.createElement('span');
    spacer.className = 'row__spacer';

    head.append(handle, name, spacer);

    if (!isNew) {
      /*
       * The id chip doubles as the drag grip.
       *
       * draggable is switched on only while the pointer is held on this handle,
       * and off again on dragend. Marking the whole card permanently draggable
       * is the usual shortcut and it breaks the card: you can no longer select
       * text inside its inputs, because the browser starts a drag instead of a
       * selection.
       */
      handle.classList.add('row__handle--grip');
      handle.title = 'Drag to reorder';
      handle.addEventListener('pointerdown', () => {
        card.draggable = true;
      });
      handle.addEventListener('pointerup', () => {
        card.draggable = false;
      });
      card.addEventListener('dragend', () => {
        card.draggable = false;
      });

      const up = document.createElement('button');
      up.type = 'button';
      up.className = 'btn btn--sm btn--icon';
      up.dataset.move = 'up';
      up.setAttribute('aria-label', `Move ${name.textContent} up`);
      up.textContent = '↑';

      const down = document.createElement('button');
      down.type = 'button';
      down.className = 'btn btn--sm btn--icon';
      down.dataset.move = 'down';
      down.setAttribute('aria-label', `Move ${name.textContent} down`);
      down.textContent = '↓';

      head.append(up, down);
    }

    const save = document.createElement('button');
    save.type = 'button';
    save.className = 'btn btn--sm btn--primary';
    save.dataset.save = '';
    save.textContent = isNew ? 'Create' : 'Save';
    save.disabled = !isNew;

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'btn btn--sm btn--danger';
    del.dataset.delete = '';
    del.textContent = isNew ? 'Discard' : 'Delete';

    head.append(save, del);
    card.append(head);

    // Fields
    const onTitle = (v: string) => {
      name.textContent = v || '(untitled)';
    };

    for (const s of CFG.sections) {
      const grid = document.createElement('div');
      grid.className = 'field-grid';
      for (const f of s.fields) {
        const uid = `${CFG.table}-${row.id ?? 'new'}-${f.name}`;
        grid.append(buildField(f, row, uid, markDirty, onTitle));
      }

      if (!CFG.showLegends) {
        card.append(grid);
        continue;
      }

      const set = document.createElement('fieldset');
      set.className = 'fieldset';
      const leg = document.createElement('legend');
      leg.className = 'fieldset__legend';
      leg.textContent = s.label;
      set.append(leg, grid);
      card.append(set);
    }

    return card;
  }

  function collect(card: HTMLElement) {
    const body: Record<string, any> = {};
    card.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
      const kind = el.dataset.kind;
      if (kind === 'boolean') body[el.dataset.field!] = (el as HTMLInputElement).checked ? 1 : 0;
      else if (kind === 'number') {
        const v = (el as HTMLInputElement).value;
        body[el.dataset.field!] = v === '' ? null : Number(v);
      } else body[el.dataset.field!] = (el as HTMLInputElement).value;
    });
    return body;
  }

  // --- Actions ----------------------------------------------------------
  /**
   * The `required` flags in schema.ts are enforced here and nowhere else.
   *
   * D1 will not catch these: '' satisfies NOT NULL on a TEXT column, so a
   * project with no title and no body saves cleanly, returns ok, and then
   * renders as an empty card on the live site. Same shape as the title+slug gate
   * in admin/posts/[id].astro.
   */
  function firstMissing(body: Record<string, any>) {
    return (
      allFields.find((f) => f.required && !String(body[f.name] ?? '').trim()) ?? null
    );
  }

  async function saveRow(card: HTMLElement) {
    const body = collect(card);
    const isNew = card.dataset.new === 'true';

    const missing = firstMissing(body);
    if (missing) {
      setStatus(
        `${missing.label} is required — blank saves fine and then renders as an empty card on the live site.`,
        'err',
        true
      );
      const el = card.querySelector<HTMLElement>(`[data-field="${missing.name}"]`);
      el?.setAttribute('aria-invalid', 'true');
      el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      el?.focus();
      return;
    }

    const btn = card.querySelector<HTMLButtonElement>('[data-save]')!;
    btn.disabled = true;
    setStatus('Saving…', 'busy', true);

    try {
      if (isNew) {
        const data = await api(`/api/content/${CFG.table}`, {
          method: 'POST',
          body: JSON.stringify(body),
        });
        setStatus('Row created.', 'ok');
        card.dataset.id = String(data.id);
        delete card.dataset.new;
        card.classList.remove('row--new', 'row--dirty');
        // Rebuild so it gains its id, arrows and real Save/Delete labels.
        await load();
      } else {
        await api(`/api/content/${CFG.table}`, {
          method: 'PUT',
          body: JSON.stringify({ ...body, id: Number(card.dataset.id) }),
        });
        card.classList.remove('row--dirty');
        setStatus('Saved.', 'ok');
      }
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Save failed.', 'err', true);
      btn.disabled = false;
    }
  }

  async function deleteRow(card: HTMLElement) {
    if (card.dataset.new === 'true') {
      card.remove();
      return;
    }
    setStatus('Deleting…', 'busy', true);
    try {
      await api(`/api/content/${CFG.table}?id=${encodeURIComponent(card.dataset.id!)}`, {
        method: 'DELETE',
      });
      card.remove();
      rows = rows.filter((r) => String(r.id) !== card.dataset.id);
      setStatus('Deleted.', 'ok');
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Delete failed.', 'err', true);
    }
  }

  /**
   * Reorder by swapping the two rows' sort_order values.
   *
   * Two PUTs, not one: the API updates a single row at a time, so a swap is
   * inherently non-atomic here. If the second fails the first is rolled back by
   * hand, otherwise two rows would share a sort_order and the order would go
   * quietly wrong.
   */
  async function move(card: HTMLElement, dir: 'up' | 'down') {
    const cards = Array.from(rowsEl.querySelectorAll<HTMLElement>('.row:not([data-new])'));
    const i = cards.indexOf(card);
    const j = dir === 'up' ? i - 1 : i + 1;
    if (j < 0 || j >= cards.length) return;

    const other = cards[j];
    const a = collect(card);
    const b = collect(other);
    const aOrder = a.sort_order;
    const bOrder = b.sort_order;

    setStatus('Reordering…', 'busy', true);
    try {
      await api(`/api/content/${CFG.table}`, {
        method: 'PUT',
        body: JSON.stringify({ ...a, sort_order: bOrder, id: Number(card.dataset.id) }),
      });
      try {
        await api(`/api/content/${CFG.table}`, {
          method: 'PUT',
          body: JSON.stringify({ ...b, sort_order: aOrder, id: Number(other.dataset.id) }),
        });
      } catch (inner) {
        await api(`/api/content/${CFG.table}`, {
          method: 'PUT',
          body: JSON.stringify({ ...a, sort_order: aOrder, id: Number(card.dataset.id) }),
        }).catch(() => {});
        throw inner;
      }
      setStatus('Reordered.', 'ok');
      await load();
      // Keep the keyboard where the reader left it.
      const moved = rowsEl.querySelector<HTMLElement>(`.row[data-id="${card.dataset.id}"]`);
      moved?.querySelector<HTMLButtonElement>(`[data-move="${dir}"]`)?.focus();
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Reorder failed.', 'err', true);
    }
  }

  /* ---------------------------------------------------------------------
     Drag to reorder

     A pointer alternative to the arrows, not a replacement for them. HTML5
     drag-and-drop does not fire on touch at all, and dragging is not reachable
     from a keyboard, so removing the arrows would make reordering impossible on
     a phone and impossible without a mouse. Both paths write the same column.

     The arrows swap two adjacent rows through the generic row endpoint. A drag
     can move a row anywhere, which renumbers every row in between, so it posts
     the whole resulting order to /api/reorder and lets D1 apply it in one batch.
     --------------------------------------------------------------------- */

  /** Ordered, saved rows only — a half-filled "new" card has no place in an order. */
  const orderedCards = () =>
    Array.from(rowsEl.querySelectorAll<HTMLElement>('.row:not([data-new])'));

  /**
   * The card the dragged row should be inserted BEFORE, decided by pointer
   * position against each card's vertical midpoint. Returns null for "past the
   * last one", which append handles.
   */
  function cardAfter(y: number, dragging: HTMLElement): HTMLElement | null {
    let closest: HTMLElement | null = null;
    let closestOffset = Number.NEGATIVE_INFINITY;

    for (const card of orderedCards()) {
      if (card === dragging) continue;
      const box = card.getBoundingClientRect();
      const offset = y - box.top - box.height / 2;
      // The largest negative offset is the nearest card whose midpoint we are
      // still above — i.e. the one we would land in front of.
      if (offset < 0 && offset > closestOffset) {
        closestOffset = offset;
        closest = card;
      }
    }
    return closest;
  }

  let draggingCard: HTMLElement | null = null;
  /** DOM order before the drag, so a failed save can be visually rolled back. */
  let orderBeforeDrag: string[] = [];

  rowsEl.addEventListener('dragstart', (e) => {
    const card = (e.target as HTMLElement)?.closest<HTMLElement>('.row:not([data-new])');
    if (!card) return;

    draggingCard = card;
    orderBeforeDrag = orderedCards().map((c) => c.dataset.id!);
    card.classList.add('row--dragging');

    // Firefox refuses to start a drag unless setData is called.
    e.dataTransfer?.setData('text/plain', card.dataset.id ?? '');
    if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
  });

  rowsEl.addEventListener('dragover', (e) => {
    if (!draggingCard) return;
    // Without preventDefault the browser treats the area as an invalid target
    // and never fires drop.
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';

    const before = cardAfter(e.clientY, draggingCard);
    if (before) rowsEl.insertBefore(draggingCard, before);
    else rowsEl.append(draggingCard);
  });

  rowsEl.addEventListener('drop', (e) => {
    if (!draggingCard) return;
    e.preventDefault();
    const card = draggingCard;
    card.classList.remove('row--dragging');
    draggingCard = null;
    void persistOrder(card);
  });

  // Dropping outside the list, or pressing Escape mid-drag, fires dragend
  // without drop. The DOM has already been reordered by dragover, so the
  // pre-drag order has to be put back or the screen would keep showing a move
  // that was never committed.
  rowsEl.addEventListener('dragend', () => {
    if (!draggingCard) return;
    draggingCard.classList.remove('row--dragging');
    draggingCard = null;
    restoreOrder(orderBeforeDrag);
  });

  function restoreOrder(ids: string[]) {
    for (const id of ids) {
      const card = rowsEl.querySelector<HTMLElement>(`.row[data-id="${id}"]`);
      if (card) rowsEl.append(card);
    }
  }

  async function persistOrder(moved: HTMLElement) {
    const ids = orderedCards().map((c) => Number(c.dataset.id));

    // Nothing actually moved — don't spend a write on it.
    if (ids.join() === orderBeforeDrag.join()) return;

    setStatus('Saving order…', 'busy', true);
    try {
      await api('/api/reorder', {
        method: 'POST',
        body: JSON.stringify({ table: CFG.table, ids }),
      });
      setStatus('Order saved.', 'ok');
      await load();
      /*
       * Put focus on the moved row's up-arrow, exactly as move() does. Not the
       * drag handle: it is a <span>, so it takes no focus, and calling focus()
       * on it would silently do nothing while looking like it had been handled.
       */
      rowsEl
        .querySelector<HTMLButtonElement>(`.row[data-id="${moved.dataset.id}"] [data-move="up"]`)
        ?.focus();
    } catch (err) {
      // The list on screen no longer matches the database, so put it back rather
      // than leave a lie in front of the reader.
      restoreOrder(orderBeforeDrag);
      setStatus(err instanceof Error ? err.message : 'Could not save the new order.', 'err', true);
    }
  }

  // --- Inline confirm ---------------------------------------------------
  let openConfirm: HTMLElement | null = null;

  function closeConfirm() {
    if (!openConfirm) return;
    openConfirm.remove();
    openConfirm = null;
  }

  function confirmDelete(trigger: HTMLButtonElement, card: HTMLElement) {
    closeConfirm();
    const box = document.createElement('span');
    box.className = 'confirm';
    const text = document.createElement('span');
    text.className = 'confirm__text';
    text.textContent = 'Delete this row?';

    const yes = document.createElement('button');
    yes.type = 'button';
    yes.className = 'btn btn--sm btn--danger';
    yes.textContent = 'Delete';
    yes.addEventListener('click', () => {
      closeConfirm();
      void deleteRow(card);
    });

    const no = document.createElement('button');
    no.type = 'button';
    no.className = 'btn btn--sm';
    no.textContent = 'Cancel';
    no.addEventListener('click', () => {
      closeConfirm();
      trigger.focus();
    });

    box.append(text, yes, no);
    trigger.after(box);
    openConfirm = box;
    yes.focus();
  }

  rowsEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const card = t.closest<HTMLElement>('.row');
    if (!card) return;

    if (t.closest('[data-save]')) void saveRow(card);
    else if (t.closest('[data-delete]')) {
      const btn = t.closest('[data-delete]') as HTMLButtonElement;
      if (card.dataset.new === 'true') card.remove();
      else confirmDelete(btn, card);
    } else if (t.closest('[data-move]')) {
      void move(card, (t.closest('[data-move]') as HTMLElement).dataset.move as 'up' | 'down');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && openConfirm) {
      e.stopPropagation();
      closeConfirm();
    }
  });

  document.getElementById('add-row')?.addEventListener('click', () => {
    const blank: Record<string, any> = {};
    /*
      Seeded BY KIND, never by a blanket ''. A number seeded '' collects back as
      null and a boolean as 0, so neither can hand SQLite the empty string an
      INTEGER column silently stores as TEXT. Undescribed columns are seeded with
      nothing at all: they carry no data-field, so the INSERT omits them and the
      column default applies — which is the correct answer for a column this page
      admits it does not understand.
    */
    for (const f of allFields) {
      if (f.unspecified) continue;
      blank[f.name] = f.kind === 'boolean' ? 0 : f.kind === 'number' ? null : '';
    }
    // Put it at the end by default rather than fighting existing rows for slot 0.
    blank.sort_order = rows.length
      ? Math.max(...rows.map((r) => Number(r.sort_order) || 0)) + 1
      : 0;
    const card = buildRow(blank, true);
    rowsEl.append(card);
    card.querySelector<HTMLInputElement>('input, textarea')?.focus();
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  // --- Load -------------------------------------------------------------
  async function load() {
    rowsEl.setAttribute('aria-busy', 'true');
    try {
      const { data } = await api(`/api/content/${CFG.table}`);
      rows = data;
      rowsEl.textContent = '';
      if (!rows.length) {
        const p = document.createElement('p');
        p.className = 'muted';
        p.textContent = 'No rows yet. Use the button in the header to add the first one.';
        rowsEl.append(p);
      } else {
        rows.forEach((r) => rowsEl.append(buildRow(r)));
      }
    } catch (err) {
      rowsEl.textContent = '';
      const p = document.createElement('p');
      p.className = 'status status--err';
      p.textContent = err instanceof Error ? err.message : 'Could not load rows.';
      rowsEl.append(p);
    } finally {
      rowsEl.removeAttribute('aria-busy');
    }
  }

  void load();
</script>
