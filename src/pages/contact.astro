---
export const prerender = false;

import Base from '../layouts/Base.astro';
import '../styles/contact.css';
import { getSettings, setting } from '../lib/db';
import { altLocalesFor } from '../lib/i18n';

const settings = await getSettings();

const siteUrl = setting(settings, 'site_url', 'https://ibrahimaher.com').replace(/\/$/, '');

// The Web3Forms access key lives in the settings table, not in the markup, so it
// can be rotated from the admin without a redeploy.
const web3formsKey = setting(settings, 'web3forms_key');

// Keywords are still the old contact.html's. Title and description are not: both
// were over length as ported (69 and 171), so both were rewritten to fit the
// 60 / 120-160 windows Google actually renders. The title lost "Accounts" rather
// than the name — "Contact <name>" is the query this page can win, and marketing
// and automation are the two things people write in about; accounts work survives
// in the description, the "Best for" aside and the reason dropdown. The
// description now mirrors the page's own lede (offer, location, "I reply myself")
// instead of the generic "Get in touch with…" opener, which spent 18 characters
// before saying anything.
const metaTitle = 'Contact Ibrahim Maher Al-Bander | Marketing & Automation';
const metaDesc =
  'Marketing role, accounts position, or an n8n automation project: send a note. Based in Erbil, open to remote work, and I reply to every message myself.';
const metaKeywords =
  'contact Ibrahim Al-Bander, hire n8n developer Erbil, hire AI automation developer Iraq, hire social media marketer Erbil, Ibrahim Maher Al-Bander email';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: `${siteUrl}/contact`,
    name: 'Contact Ibrahim Maher Al-Bander',
    about: {
      '@type': 'Person',
      name: 'Ibrahim Maher Al-Bander',
      email: 'mailto:me@ibrahimaher.com',
      // E.164, matching the tel: href below. Same typo as index.astro — those two
      // schema literals were the only strings deviating from the repo's own format.
      telephone: '+9647719620471',
      url: siteUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${siteUrl}/contact` },
    ],
  },
];

const elsewhere = [
  { href: 'https://www.linkedin.com/in/ibrahimaher', label: 'LinkedIn' },
  { href: 'https://www.facebook.com/ibmabr', label: 'Facebook' },
  { href: 'https://www.instagram.com/ibmabr', label: 'Instagram' },
  { href: 'https://t.me/ibmabr', label: 'Telegram' },
];

const faqs = [
  {
    q: 'How fast do you actually reply?',
    a: 'Every message on this form goes straight to my personal inbox, not a shared support queue. I read and reply to it myself, almost always within a day, sometimes the same hour depending on timezone overlap.',
  },
  {
    q: 'Do you take on standalone automation projects?',
    a: "Yes. Most of my n8n and AI automation work comes in as scoped freelance projects: invoice screening, lead scoring, reporting pipelines, that kind of thing. Tell me roughly what the workflow needs to do and what tools it touches, and I'll follow up with scope and a rate.",
  },
  {
    q: 'Are you open to full-time or in-house roles too?',
    a: "My focus is AI automation — n8n workflows, AI agents and chatbots, and social media automation — and I'm already committed at Help Tech Co. Ltd., so a new in-house role would need to be a genuinely better fit. I'm always open to hearing about it, especially anything automation- or AI-adjacent.",
  },
  {
    q: 'Do you work with clients outside Iraq?',
    a: "Yes, remotely. I'm based in Erbil (UTC+3) and have shipped automation work for clients in different timezones without issue. Async communication and clear documentation are part of how I hand off every workflow, so overlap hours matter less than you'd think.",
  },
  {
    q: 'What should I actually put in the message?',
    a: 'Whatever gets me to a useful reply fastest: what you\'re trying to solve, roughly what tools or platforms are involved, and any timeline or budget constraints you already have in mind. Vague "let\'s chat" messages get a reply too, just a slower one.',
  },
];

/*
 * FAQPage node, built from the same `faqs` array rendered below so the structured
 * data can never describe an answer the page does not show — the homepage does the
 * same with its own FAQ block. Google restricted FAQ rich results to gov/health
 * sites in 2023, so this earns no snippet; the value is structured-data consistency
 * and AI-answer extraction (Bing/Copilot, ChatGPT, Perplexity). The answers are
 * plain text with no inline HTML, so they are safe as JSON-LD literals.
 */
jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const reasons = [
  'Marketing role or project',
  'Accounts / bookkeeping work',
  'n8n or AI automation project',
  'Something else',
];
---

<Base
  title={metaTitle}
  description={metaDesc}
  canonical="/contact"
  keywords={metaKeywords}
  jsonLd={jsonLd}
  altLocales={altLocalesFor('/contact')}
>
  <div class="shell contact">
    <header class="contact__head stagger">
      <nav class="contact__crumbs" aria-label="Breadcrumb" style="--i:0">
        <a class="link" href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span class="muted">Contact</span>
      </nav>

      <p class="eyebrow" style="--i:1">Get in touch</p>

      <h1 class="contact__title" style="--i:2">
        Let's talk about <span class="accent">the work</span>
      </h1>

      <p class="lede contact__lede" style="--i:3">
        Marketing role, accounts position, or an automation project that needs building properly:
        send a note below or reach me directly. I read everything that comes in and reply myself,
        usually within a day.
      </p>
    </header>

    <div class="contact__body">
      {/*
        Web3Forms — same endpoint, same field names, same honeypot as the old
        page. Only the access key moved: it now comes from the settings table.
        The form posts natively if JS never runs; the script below upgrades it
        to a fetch so the reader is not thrown to api.web3forms.com's own page.
      */}
      <form
        class="form reveal"
        id="contactForm"
        action="https://api.web3forms.com/submit"
        method="POST"
        aria-labelledby="form-h"
      >
        <h2 id="form-h" class="eyebrow">Send a note</h2>

        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value="New message from ibrahimaher.com" />
        <input type="hidden" name="from_name" value="ibrahimaher.com contact form" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label class="field__label" for="name">Name</label>
          <input class="field__input" type="text" id="name" name="name" required autocomplete="name" />
        </div>

        <div class="field">
          <label class="field__label" for="email">Email</label>
          <input class="field__input" type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label class="field__label" for="reason">What is this about</label>
          <select class="field__input" id="reason" name="reason">
            {reasons.map((r) => <option>{r}</option>)}
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="message">Message</label>
          <textarea class="field__input field__textarea" id="message" name="message" required></textarea>
        </div>

        <button type="submit" class="btn form__submit">Send message</button>

        <p class="form__status" id="formStatus" role="status" aria-live="polite"></p>
      </form>

      <aside class="aside">
        <section class="aside__block reveal" aria-labelledby="direct-h">
          <h2 id="direct-h" class="eyebrow">Direct</h2>
          <ul class="aside__list">
            <li><a class="link" href="mailto:me@ibrahimaher.com">me@ibrahimaher.com</a></li>
            <li><a class="link" href="tel:+9647719620471">+964 (0)771 962 0471</a></li>
            <li class="muted">Erbil, Iraq · open to remote work</li>
          </ul>
        </section>

        <section class="aside__block reveal" aria-labelledby="elsewhere-h">
          <h2 id="elsewhere-h" class="eyebrow">Elsewhere</h2>
          <ul class="aside__list">
            {
              elsewhere.map((e) => (
                <li>
                  <a class="link" href={e.href} target="_blank" rel="noopener">
                    {e.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="aside__block reveal" aria-labelledby="best-h">
          <h2 id="best-h" class="eyebrow">Best for</h2>
          <p class="aside__note">
            Social media marketing roles or projects, accounts and bookkeeping setup, and n8n or AI
            agent automation work. See <a class="link" href="/#projects">Projects</a> for examples,
            or <a class="link" href="/about">About</a> for the full background.
          </p>
        </section>
      </aside>
    </div>

    <section class="section rail" aria-labelledby="faq-h">
      <p class="eyebrow">Before you send that message</p>
      <div>
        <h2 id="faq-h" class="section-title">A few things worth knowing</h2>
        <p class="lede faq__sub">Answers to what people usually ask before reaching out.</p>

        <ul class="faqs">
          {
            faqs.map((f) => (
              <li class="faq reveal">
                <h3 class="faq__q">{f.q}</h3>
                <p class="faq__a">{f.a}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  // Ported from script.src.js: the form submits over fetch so the reader stays
  // on the page, and falls back to a plain POST if this never runs.
  const form = document.getElementById('contactForm') as HTMLFormElement | null;

  if (form) {
    const statusEl = document.getElementById('formStatus') as HTMLParagraphElement | null;
    const submitBtn = form.querySelector('.form__submit') as HTMLButtonElement | null;

    const setStatus = (text: string, state: '' | 'success' | 'error') => {
      if (!statusEl) return;
      statusEl.textContent = text;
      // dataset, not className — overwriting the class would strip Astro's
      // scope hash and the status would lose its styling entirely.
      statusEl.dataset.state = state;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }
      setStatus('', '');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = (await response.json()) as { success?: boolean };

        if (result.success) {
          setStatus("Thanks, that's sent. I will get back to you soon.", 'success');
          form.reset();
        } else {
          setStatus(
            'Something went wrong sending that. Please email me directly instead.',
            'error'
          );
        }
      } catch {
        setStatus('Something went wrong sending that. Please email me directly instead.', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send message';
        }
      }
    });
  }
</script>
