    OS-dark machine has no data-theme at all. Without this they get the light
    screenshot on dark paper. (The v1 rules this is ported from omit exactly
    this fallback and have that bug.)
  */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .shot-light {
      display: none;
    }

    :root:not([data-theme='light']) .shot-dark {
      display: block;
    }
  }

