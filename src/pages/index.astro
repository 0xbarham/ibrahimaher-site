---
export const prerender = false;

import Base from '../layouts/Base.astro';
import SocialIcon, { type SocialName } from '../components/SocialIcon.astro';
import {
  getJobs,
  getProjects,
  getSkills,
  getCertifications,
  getEducation,
  getPublishedPosts,
  getSettings,
  setting,
  parseTags,
} from '../lib/db';

const [jobs, projects, skills, certifications, education, posts, settings] = await Promise.all([
  getJobs(),
  getProjects(),
  getSkills(),
  getCertifications(),
  getEducation(),
  getPublishedPosts(3),
  getSettings(),
]);

const siteUrl = setting(settings, 'site_url', 'https://ibrahimaher.com').replace(/\/$/, '');
const siteName = setting(settings, 'site_name', 'Ibrahim Maher Al-Bander');
const siteTagline = setting(settings, 'site_tagline', 'Social Media Marketer · Accounts & Automation');
const ogImage = setting(settings, 'default_og_image', '/assets/og-image.png');

/**
 * Several D1 columns (`company`, `title`, `tags_json`) hold HTML *source* —
 * `&amp;`, `&middot;` — because they were lifted straight out of the old static
 * markup. They are correct through `set:html`, but Astro escapes plain text
 * nodes, so anything printed as text has to be decoded first or the reader sees
 * a literal "&middot;". `&amp;` must go last so "&amp;middot;" is not
 * double-decoded.
 */
const decode = (s: string): string =>
  s
    .replace(/&middot;/g, '·')
    .replace(/&rarr;/g, '→')
    .replace(/&nbsp;/g, ' ')
    .replace(/&quot;/g, '"')
    .replace(/&#0?39;/g, "'")
    .replace(/&apos;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&');

/** Logo paths are stored relative ("assets/logos/…"), as the old root-level page used them. */
const asset = (p: string): string => (/^(https?:)?\//.test(p) ? p : `/${p}`);

/**
 * Wrap a path as a CSS url() token for an inline `style` attribute.
 *
 * Astro escapes the attribute for HTML, which stops a value breaking out of the
 * tag, but not out of the CSS value — a quote or paren would close the url() and
 * let the rest be read as declarations. The only caller passes a literal from
 * `aiTools` below, so this is a guard rather than a live fix, but it is what
 * makes the token safe to build from anything, including a D1 path later.
 * encodeURI is deliberately not used: it leaves quotes and parens intact, and
 * would double-encode a path that already carries a %.
 */
const cssUrl = (p: string): string =>
  `url("${p.replace(/["'()\\\s]/g, (c) => `%${c.charCodeAt(0).toString(16).padStart(2, '0')}`)}")`;

const featured = projects.find((p) => p.featured === 1) ?? null;
const smallProjects = projects.filter((p) => p.featured !== 1);

const dateLabel = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

/* The four-layer framework. Ibrahim's own terminology, carried over word for
   word from the old index.html — there is no table behind it yet.
   `def` is deliberately one self-contained paragraph per term: it is both the
   on-page definition and the DefinedTerm description below, so the two can
   never drift apart, and each reads correctly lifted out of its context. */
const disciplines = [
  {
    num: '01',
    id: 'prompt-engineering',
    term: 'Prompt Engineering',
    def: `Optimizes the instruction. This is what most people mean when they say "AI skills": how you phrase a request, assign a persona, set formatting rules, and give clear constraints for a single interaction. It matters, but it only covers one exchange, it does not survive a long project on its own.`,
    analogy: 'Like giving a new hire their daily task list.',
  },
  {
    num: '02',
    id: 'context-engineering',
    term: 'Context Engineering',
    def: `Optimizes the information. It manages what the model's context window actually sees: retrieval-augmented generation, memory management, and picking the right documents, code, or prior decisions to surface at the right moment. Bad context engineering is why AI tools "forget" things mid-project. I treat this as a first-class design problem, not an afterthought.`,
    analogy: 'Like handing them the correct project binders before they start.',
  },
  {
    num: '03',
    id: 'harness-engineering',
    term: 'Harness Engineering',
    def: `Optimizes the execution environment. This is the closed-loop system around the model: what tools it can call, what guardrails stop it from doing something destructive, and how output gets validated before it is trusted. This is the layer that turns "the AI wrote something" into "the AI's work is safe to ship," and it is most of what I actually build when I automate something with n8n.`,
    analogy:
      'Like designing the workspace, the rules, and the oversight the employee works under.',
  },
  {
    num: '04',
    id: 'loop-engineering',
    term: 'Loop Engineering',
    def: `Automates the repetition. It builds on harness engineering to let agents run for hours without me watching: spawning helper agents for sub-tasks, checking their own results against a standard, and self-correcting when something is off. Sites like DAD LINK get built this way, in long autonomous passes with checkpoints, not one prompt at a time.`,
    analogy:
      'Like an employee who runs their own workday and only escalates what actually needs a human.',
  },
];

/* The daily tool strip, verbatim from the old page. Paths keep the `?v=2`
   cache-buster the D1 rows use for the n8n marks.

   Every mark is the same thing: a glyph used as a CSS mask, painted with the
   page's ink at rest and its brand colour on hover. A mask reads only alpha, so
   one file serves both themes and no `-white` counterpart is fetched here.

   n8n needed its own asset to join that. Its shipped logo is 296x80 — a node
   glyph (the #EA4B71 path, 0..152) followed by the word "n8n" (the #040506
   paths). At 3.70:1 in a square box the glyph rendered ~28x8, a strip, and the
   wordmark just repeated the label sitting next to it. `n8n-mark.svg` is that
   first path alone, cropped to 152x80 — 1.90:1, so the glyph is twice the size
   in the same box, and being single-colour it masks like the rest.

   Brand colours are the marks' own, not the site's. Claude's #D97757 happening
   to equal --accent is a coincidence worth keeping honest: --accent is tuned per
   theme and would drift the logo off-brand in dark mode. */
const aiTools = [
  {
    name: 'Claude',
    slug: 'claude',
    mask: 'assets/logos/claude-logo.svg',
    use: `Claude Code writes and ships the production code: this site, DAD LINK's build work, and the custom n8n function nodes I can't do with built-in blocks alone.`,
  },
  {
    name: 'ChatGPT',
    slug: 'chatgpt',
    mask: 'assets/logos/openai-logo.svg',
    use: `Fast day-to-day thinking: drafting client messages, brainstorming campaign angles, and quick lookups where I don't need a full coding session.`,
  },
  {
    name: 'Gemini',
    slug: 'gemini',
    mask: 'assets/logos/gemini-logo.svg',
    use: `The model behind my n8n workflows that read and judge things: screening invoice emails for fraud, scoring inbound leads, and extracting structured data from documents.`,
  },
  {
    name: 'n8n',
    slug: 'n8n',
    mask: 'assets/logos/n8n-mark.svg',
    use: `The automation platform that wires the models above into Gmail, Sheets, Telegram, Calendar, and GoHighLevel to run as unattended production workflows.`,
  },
] satisfies {
  name: string;
  slug: string;
  use: string;
  mask: string;
}[];

/* Contact rows, verbatim from the old contact section. The form itself stays
   on /contact — these are just the details, set as labelled rows. */
const socials: { name: SocialName; label: string; url: string }[] = [
  { name: 'linkedin', label: 'LinkedIn', url: 'https://www.linkedin.com/in/ibrahimaher' },
  { name: 'facebook', label: 'Facebook', url: 'https://www.facebook.com/ibmabr' },
  { name: 'instagram', label: 'Instagram', url: 'https://www.instagram.com/ibmabr' },
  { name: 'telegram', label: 'Telegram', url: 'https://t.me/ibmabr' },
];

const contactEmail = setting(settings, 'contact_email', 'me@ibrahimaher.com');

/* The FAQ is the one block on this page with no table behind it: it was written
   by hand in the old index.html and is carried over verbatim, answers and links
   included. The `a` strings are HTML on purpose — they contain the same inline
   links the original had. */
const faqs = [
  {
    q: 'Who is Ibrahim Maher Al-Bander?',
    a: 'A social media marketer, accounts and inventory officer, and freelance AI automation developer based in Erbil, Iraq, currently working three roles at Help Tech Co. Ltd. while running an independent n8n automation practice. <a href="/about">Read the full story</a>.',
  },
  {
    q: 'Is he available for freelance n8n or AI automation work?',
    a: 'Yes. He designs and deploys production n8n workflows integrating OpenAI, Claude, and Gemini for lead scoring, invoice processing, and reporting. <a href="/contact">Get in touch</a> with what you need automated.',
  },
  {
    q: 'Does he do social media marketing for other businesses?',
    a: 'His main track record is in-house at Help Tech, where he grew a Facebook page more than 500 percent and ran campaigns close to 100 percent ROI, plus an agency internship at YourVisio Media managing multiple client accounts.',
  },
  {
    q: 'What is DAD LINK and did he really build it?',
    a: '<a href="https://www.dad-link.com" target="_blank" rel="noopener">DAD LINK</a> is a live B2B e-commerce store for network cabling equipment in Iraq that he designed and shipped on Odoo with Claude Code doing most of the build work. See the <a href="#projects">Projects</a> section for details.',
  },
  {
    q: 'How do I hire an n8n developer in Erbil or Iraq?',
    a: 'You can hire me directly through this site. I scope the workflow you need, build and document it in n8n, and hand it over ready to run. <a href="/n8n-developer">See what I build and how to start</a>.',
  },
  {
    q: 'Do you work with clients outside Iraq?',
    a: 'Yes. n8n work is delivered remotely, so I build and maintain workflows for clients anywhere in the world, alongside in-person work for businesses in Erbil and across the Kurdistan Region.',
  },
  {
    q: 'What can you automate with n8n?',
    a: 'AI lead scoring, invoice and document processing, fraud screening, approval pipelines, and automated reporting, wiring tools like Gmail, Sheets, Telegram and GoHighLevel into AI models. If a process is repetitive and rule-based, it can usually be automated.',
  },
];

/* JSON-LD FAQ answers are the longer, self-contained phrasings from the old
   page's script block — not the on-page text — because a rich result is read
   without the surrounding page for context. Carried over word for word. */
const faqLd = [
  {
    q: 'Who is Ibrahim Maher Al-Bander?',
    a: 'Ibrahim Maher Al-Bander is a social media marketer, accounts and inventory officer, and freelance AI automation developer based in Erbil, Iraq, currently working three roles at Help Tech Co. Ltd. while running an independent n8n automation practice.',
  },
  {
    q: 'Is Ibrahim Al-Bander available for freelance n8n or AI automation work?',
    a: 'Yes. He designs and deploys production n8n workflows integrating OpenAI, Claude, and Gemini for lead scoring, invoice processing, and reporting, and can be reached through the contact page on ibrahimaher.com.',
  },
  {
    q: 'Does Ibrahim Al-Bander do social media marketing for other businesses?',
    a: 'His main track record is in-house at Help Tech Co. Ltd., where he grew a Facebook page more than 500 percent and ran paid campaigns close to 100 percent ROI, plus an agency internship at YourVisio Media managing multiple client accounts.',
  },
  {
    q: 'What is DAD LINK and did Ibrahim Al-Bander really build it?',
    a: 'DAD LINK (dad-link.com) is a live B2B e-commerce store for network cabling equipment in Iraq that Ibrahim designed and shipped on Odoo with Claude Code doing most of the build work, including catalog structure, category pages, and on-page SEO.',
  },
  {
    q: 'How do I hire an n8n developer in Erbil or Iraq?',
    a: 'You can hire Ibrahim Al-Bander directly through ibrahimaher.com. He is an n8n and AI automation developer based in Erbil, Iraq, who scopes the workflow you need, builds and documents it in n8n, and hands it over ready to run. Projects start with a short conversation about the process you want automated.',
  },
  {
    q: 'Do you work with clients outside Iraq?',
    a: 'Yes. n8n automation work is delivered remotely, so Ibrahim builds and maintains workflows for clients anywhere in the world, alongside in-person work for businesses in Erbil and across the Kurdistan Region and Iraq.',
  },
  {
    q: 'What can you automate with n8n?',
    a: 'Common builds include AI lead scoring and auto-response, invoice and document processing, fraud screening, approval pipelines, automated reporting, and connecting tools like Gmail, Google Sheets, Telegram, Calendar, and GoHighLevel to AI models such as OpenAI, Claude, and Gemini. If a business process is repetitive and rule-based, it can usually be automated.',
  },
];

const metaTitle = setting(
  settings,
  'default_seo_title',
  'Ibrahim Maher Al-Bander | Marketer & AI Automation Developer'
);
const metaDesc = setting(
  settings,
  'default_seo_description',
  'Ibrahim Maher Al-Bander: social media marketer and AI automation developer in Erbil, Iraq, building n8n workflows, AI agents, and paid social campaigns.'
);
const metaKeywords =
  'Ibrahim Maher Al-Bander, social media marketer Erbil, n8n automation developer, AI automation Iraq, AI agent developer, prompt engineering, context engineering, harness engineering, loop engineering, Claude Code developer, DAD LINK, accounts officer Erbil, social media specialist Iraq';

const personId = `${siteUrl}/#ibrahim`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: siteName,
    alternateName: 'Ibrahim Al-Bander',
    url: siteUrl,
    image: `${siteUrl}${ogImage}`,
    jobTitle: 'n8n Automation Developer & Social Media Marketing Specialist',
    description:
      'Freelance n8n and AI automation developer based in Erbil, Iraq, building production workflows, AI agents, and business automations for clients in Iraq and worldwide.',
    worksFor: { '@type': 'Organization', name: 'Help Tech Co. Ltd.' },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Erbil',
      addressRegion: 'Kurdistan Region',
      addressCountry: 'IQ',
    },
    email: `mailto:${setting(settings, 'contact_email', 'me@ibrahimaher.com')}`,
    telephone: '+9647719620471',
    sameAs: [
      'https://www.linkedin.com/in/ibrahimaher',
      'https://www.facebook.com/ibmabr',
      'https://www.instagram.com/ibmabr',
      'https://t.me/ibmabr',
    ],
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Northern Technical University' },
    knowsAbout: [
      'n8n',
      'n8n Automation',
      'AI Automation',
      'AI Workflow Development',
      'AI Agent Development',
      'Workflow Automation',
      'Business Process Automation',
      'Prompt Engineering',
      'Context Engineering',
      'AI Agent Harness Design',
      'Loop Engineering',
      'Social Media Marketing',
      'Paid Advertising',
      'Bookkeeping',
      'Inventory Management',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${siteUrl}/#service`,
    name: 'Ibrahim Al-Bander — n8n & AI Automation Development',
    url: `${siteUrl}/n8n-developer`,
    image: `${siteUrl}${ogImage}`,
    description:
      'Freelance n8n and AI automation development in Erbil, Iraq. Production n8n workflows, AI agents, invoice and lead automation, and business process automation for clients across Iraq, the Kurdistan Region, and remotely worldwide.',
    provider: { '@id': personId },
    founder: { '@id': personId },
    areaServed: [
      { '@type': 'City', name: 'Erbil' },
      { '@type': 'AdministrativeArea', name: 'Kurdistan Region' },
      { '@type': 'Country', name: 'Iraq' },
      'Worldwide (remote)',
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Erbil',
      addressRegion: 'Kurdistan Region',
      addressCountry: 'IQ',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 36.1901, longitude: 44.0091 },
    telephone: '+9647719620471',
    email: `mailto:${setting(settings, 'contact_email', 'me@ibrahimaher.com')}`,
    priceRange: '$$',
    makesOffer: {
      '@type': 'OfferCatalog',
      name: 'n8n & AI automation services',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'n8n workflow automation', serviceType: 'n8n workflow automation' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI agent & chatbot development', serviceType: 'AI agent development' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI invoice & lead automation', serviceType: 'AI document and lead automation' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Business process automation', serviceType: 'Business process automation' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Integrations & custom n8n function nodes', serviceType: 'API integration' } },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: siteUrl,
    name: siteName,
    description: 'n8n and AI automation developer in Erbil, Iraq.',
    inLanguage: 'en',
    publisher: { '@id': personId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqLd.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

/* The four-layer framework as coined terminology. `description` is the exact
   same string the page renders, so the schema can never describe something the
   reader cannot see — the fastest way to turn a rich result into a penalty. */
jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${siteUrl}/#ai-disciplines`,
  name: 'Beyond prompting',
  url: `${siteUrl}/#ai-disciplines`,
  inLanguage: 'en',
  creator: { '@type': 'Person', name: siteName, url: siteUrl },
  hasDefinedTerm: disciplines.map((d) => ({
    '@type': 'DefinedTerm',
    '@id': `${siteUrl}/#${d.id}`,
    name: d.term,
    description: d.def,
    url: `${siteUrl}/#${d.id}`,
    inDefinedTermSet: { '@id': `${siteUrl}/#ai-disciplines` },
  })),
});

// The DAD LINK node only exists if the featured row does — no orphan schema
// describing a project the page is not actually showing.
if (featured?.external_url) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'DAD LINK',
    url: featured.external_url,
    description:
      'B2B e-commerce website for network infrastructure equipment in Iraq: Cat.6 and Cat.6A structured cabling, fiber optic patch cords, server racks and cabinets, and HDMI 2.1 cables, built on Odoo with Claude Code.',
    creator: { '@type': 'Person', name: siteName, url: siteUrl },
    about: [
      'Network cabling Iraq',
      'Cat6 cable',
      'Cat6A cable',
      'Fiber optic patch cord',
      'Server rack cabinet',
      'HDMI 2.1 cable',
      'Structured cabling',
    ],
  });
}
---

<Base
  title={metaTitle}
  description={metaDesc}
  canonical="/"
  keywords={metaKeywords}
  ogType="profile"
  jsonLd={jsonLd}
>
  <div class="shell">
    {/* ---------------------------------------------------------------- Hero */}
    <section class="section hero stagger" aria-labelledby="hero-h">
      <p class="eyebrow" style="--i:0">Hello, I'm</p>

      <h1 class="hero__name" id="hero-h" style="--i:1">
        Ibrahim Maher<br /><span class="hero__last">Al-Bander</span>
      </h1>

      <p class="hero__role" style="--i:2">{decode(siteTagline)}</p>

      <p class="hero__tagline muted" style="--i:3">
        Based in Erbil, Iraq &middot; growth, numbers, and n8n, done properly
      </p>

      <div class="hero__actions" style="--i:4">
        <a class="btn" href="/n8n-developer">Hire an n8n developer</a>
        <a class="btn btn-ghost" href="/contact">
          Get in touch <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn-ghost" href="/about">
          More about me <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <p class="hero__lead" style="--i:5">
        I work across three things at once: social media marketing, accounting and inventory
        operations, and building AI automations with n8n. Most people specialize in one of those. I
        have spent the last few years getting good at all three, and they feed each other more than
        you would expect. The reporting instincts I built doing bookkeeping made my marketing
        numbers sharper. The automation skills I picked up building workflows now save my own team
        hours every week.
      </p>

      {/* Figures set as a rule-separated row of type rather than three stat
          cards — the numbers are the point, the container was never the point. */}
      <dl class="hero__stats" style="--i:6">
        <div class="hero__stat">
          <dt class="hero__stat-num">500%+</dt>
          <dd class="hero__stat-label">Facebook page growth delivered</dd>
        </div>
        <div class="hero__stat">
          <dt class="hero__stat-num">~100%</dt>
          <dd class="hero__stat-label">ROI on paid campaigns</dd>
        </div>
        <div class="hero__stat">
          <dt class="hero__stat-num">3</dt>
          <dd class="hero__stat-label">roles held at once, same company</dd>
        </div>
      </dl>
    </section>

    {/* ---------------------------------------------------------- Experience */}
    <section class="section" id="experience" aria-labelledby="experience-h">
      <div class="rail">
        <p class="eyebrow">Career</p>
        <div>
          <h2 class="section-title" id="experience-h">Experience</h2>
          <p class="lede">
            What I have actually been doing, day to day, for the last few years.
          </p>

          <div class="jobs">
            {
              jobs.map((job, i) => (
                <article class="job reveal">
                  <div class="job__aside">
                    <span class="job__index" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {/*
                       Only mark the light mark swappable when a dark variant
                       actually exists. Help Tech and YourVisio have logo_dark
                       NULL, and hiding .logo-light in dark mode unconditionally
                       made them disappear entirely. Logos with no dark variant
                       get a light plate instead, so a dark-ink mark stays
                       legible on dark paper.
                    */}
                    <span class:list={['job__logo', { 'job__logo--plate': !job.logo_dark }]}>
                      {/* Decorative: the company name is set in type directly
                          beside it, so an alt would only repeat the sentence. */}
                      <img
                        class:list={['logo-mark', { 'logo-light': job.logo_dark }]}
                        src={asset(job.logo_light)}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                        width="66"
                        height="66"
                      />
                      {job.logo_dark && (
                        <img
                          class="logo-mark logo-dark"
                          src={asset(job.logo_dark)}
                          alt=""
                          aria-hidden="true"
                          loading="lazy"
                          decoding="async"
                          width="66"
                          height="66"
                        />
                      )}
                    </span>
                  </div>

                  <div class="job__main">
                    <p class="eyebrow">{decode(job.eyebrow)}</p>
                    <h3 class="job__title">{decode(job.title)}</h3>
                    <p class="job__meta">
                      <span>{decode(job.company)}</span>
                      <span class="job__date">{decode(job.date_range)}</span>
                    </p>

                    <div class="job__body" set:html={job.body_html} />

                    {parseTags(job.tags_json).length > 0 && (
                      <ul class="tags" aria-label={`Skills used as ${decode(job.title)}`}>
                        {parseTags(job.tags_json).map((t) => (
                          <li class="tag">{decode(t)}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ Projects */}
    <section class="section" id="projects" aria-labelledby="projects-h">
      <div class="rail">
        <p class="eyebrow">Automation</p>
        <div>
          <h2 class="section-title" id="projects-h">Projects</h2>

          {
            /*
              DAD LINK leads the section. It is the only shipped *product* here,
              so it goes first and takes the panel treatment — a surface, a
              generous radius and an accent edge — while the workflow cards below
              stay flat on the paper. It has no screenshot, so its weight has to
              come from scale and space rather than from an image.
            */
            featured && (
              <article class="headline reveal" aria-labelledby="featured-h">
                <p class="eyebrow headline__eyebrow">Featured build</p>

                {featured.featured_logo && (
                  <img
                    class="headline__logo"
                    src={asset(featured.featured_logo)}
                    alt="DAD LINK logo"
                    loading="lazy"
                    decoding="async"
                    width="120"
                    height="60"
                  />
                )}

                <h3 class="headline__title" id="featured-h">
                  {featured.external_url ? (
                    <a
                      class="headline__link"
                      href={featured.external_url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {decode(featured.title)}
                    </a>
                  ) : (
                    decode(featured.title)
                  )}
                </h3>

                <div class="headline__body" set:html={featured.body_html} />

                {parseTags(featured.tags_json).length > 0 && (
                  <ul class="tags">
                    {parseTags(featured.tags_json).map((t) => (
                      <li class="tag">{decode(t)}</li>
                    ))}
                  </ul>
                )}

                {featured.external_url && (
                  /*
                    A span, not a second anchor: the title above already links to
                    the same destination and the whole panel is clickable through
                    it, so a real <a> here would only add a duplicate tab stop to
                    the same URL.
                  */
                  <span class="headline__cta">
                    {decode(featured.external_label || 'Visit')}{' '}
                    <span class="headline__arrow" aria-hidden="true">
                      &rarr;
                    </span>
                  </span>
                )}
              </article>
            )
          }

          <p class="lede works__lede">
            A few n8n builds I am genuinely proud of, outside of client work.
          </p>

          <ul class="works">
            {
              smallProjects.map((p) => (
                <li class="work reveal">
                  {p.image && (
                    /*
                      Framing the shot — inset inside a padded, rounded, hairline
                      surface — is what stops it reading as a pasted rectangle.
                      width/height reserve the box before the lazy image arrives,
                      so nothing shifts.

                      A pair of lazy <img>, not a themed background-image. The
                      rule of thumb that an <img> always downloads its src even
                      under display:none is only true of EAGER images: a
                      loading="lazy" image that is display:none never intersects
                      the viewport, so it is never fetched — measured here, and it
                      only arrives if a theme toggle reveals it. That buys the
                      single-variant fetch a background swap would give AND keeps
                      real lazy loading, native alt text and intrinsic sizing,
                      which a background-image on a div gives up. These sit ~5
                      screens down; as backgrounds they fetched on load and were
                      half the page's weight.

                      `shot-light` is only set when a dark counterpart exists —
                      same reasoning as the logo swap below: a lone screenshot
                      must never be hidden in dark mode.
                    */
                    <figure class="work__frame">
                      <img
                        class:list={['work__shot', 'settle-in', { 'shot-light': p.image_dark }]}
                        src={asset(p.image)}
                        alt={p.image_alt}
                        loading="lazy"
                        decoding="async"
                        width="1400"
                        height="783"
                      />
                      {p.image_dark && (
                        <img
                          class="work__shot settle-in shot-dark"
                          src={asset(p.image_dark)}
                          alt={p.image_alt}
                          loading="lazy"
                          decoding="async"
                          width="1400"
                          height="783"
                        />
                      )}
                    </figure>
                  )}

                  <div class="work__text">
                    <div class="work__head">
                      {p.icon_light && (
                        <span
                          class:list={['work__icon', { 'work__icon--plate': !p.icon_dark }]}
                          aria-hidden="true"
                        >
                          <img
                            class:list={['logo-mark', { 'logo-light': p.icon_dark }]}
                            src={asset(p.icon_light)}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            decoding="async"
                            width="52"
                            height="52"
                          />
                          {p.icon_dark && (
                            <img
                              class="logo-mark logo-dark"
                              src={asset(p.icon_dark)}
                              alt=""
                              aria-hidden="true"
                              loading="lazy"
                              decoding="async"
                              width="52"
                              height="52"
                            />
                          )}
                        </span>
                      )}

                      <h3 class="work__title">
                        {p.external_url ? (
                          /*
                            The one real anchor in the card. `.work__link::after`
                            stretches it over the whole <li>, which makes the card
                            clickable without wrapping it in an <a> — wrapping would
                            swallow the tag list and turn the described screenshot
                            into link content.
                          */
                          <a
                            class="work__link"
                            href={p.external_url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {decode(p.title)}
                          </a>
                        ) : (
                          decode(p.title)
                        )}
                      </h3>
                    </div>

                    <div class="work__body" set:html={p.body_html} />

                    {parseTags(p.tags_json).length > 0 && (
                      <ul class="tags">
                        {parseTags(p.tags_json).map((t) => (
                          <li class="tag">{decode(t)}</li>
                        ))}
                      </ul>
                    )}

                    {p.external_url && (
                      <span class="work__cta">
                        {decode(p.external_label || 'Read more')}{' '}
                        <span class="work__arrow" aria-hidden="true">
                          &rarr;
                        </span>
                      </span>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* -------------------------------------------- Beyond prompting (terms) */}
    <section class="section" id="ai-disciplines" aria-labelledby="ai-disciplines-h">
      <div class="rail">
        <p class="eyebrow">How I actually use AI</p>
        <div>
          <h2 class="section-title" id="ai-disciplines-h">Beyond prompting</h2>
          <p class="lede">
            Anyone can type a clever prompt into a chat window. Getting an AI model to do real,
            unattended, production-grade work, like building and shipping the DAD LINK storefront
            above, takes four distinct layers of skill, and most people who claim to "know AI" have
            only touched the first one.
          </p>

          {/* Each term is a heading followed immediately by its definition
              paragraph, with a stable id — so the passage is directly linkable
              and lifts out cleanly on its own. The number and the analogy sit
              outside the definition deliberately: they are commentary, and
              anything quoting the definition should get only the definition. */}
          <ol class="disciplines">
            {
              disciplines.map((d) => (
                <li class="discipline reveal">
                  <span class="discipline__num" aria-hidden="true">
                    {d.num}
                  </span>
                  <div class="discipline__main">
                    <h3 class="discipline__term" id={d.id}>
                      {d.term}
                    </h3>
                    <p class="discipline__def">{d.def}</p>
                    <p class="discipline__analogy">{d.analogy}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          {/* Tools as a labelled row of type: name, mark, and what it is for. */}
          <section class="tools" aria-labelledby="ai-tools-h">
            <h3 class="eyebrow" id="ai-tools-h">AI tools I use daily</h3>
            <dl class="tools__list">
              {
                aiTools.map((t) => (
                  <div class="tool reveal">
                    <dt class="tool__name">
                      <span
                        class:list={['tool__mark', `tool__mark--${t.slug}`]}
                        aria-hidden="true"
                        style={`--mark:${cssUrl(asset(t.mask))}`}
                      />
                      {t.name}
                    </dt>
                    <dd class="tool__use">{t.use}</dd>
                  </div>
                ))
              }
            </dl>
          </section>
        </div>
      </div>
    </section>

    {/*
      -------------------------------------------------------------- Skills

      From here down, every section carries .defer-paint (see global.css): on a
      phone the browser skips their layout and paint until they approach the
      viewport. This is the cheap half of the homepage's cost — six sections of
      rules, lists and marks that nobody has scrolled to yet.

      The cut is here and not higher for a specific reason: #experience,
      #projects, #ai-disciplines and the four discipline term ids are all
      linked by fragment (from the hero button, the FAQ answers, /about,
      /contact and the DefinedTermSet JSON-LD). Nothing anywhere links to
      #skills or below. A skipped section's height is estimated until it first
      renders, so anchoring *past* one is unreliable — keeping every real
      #target above the skipped range removes the failure mode instead of
      betting on it.
    */}
    <section class="section defer-paint" id="skills" aria-labelledby="skills-h">
      <div class="rail">
        <p class="eyebrow">Toolkit</p>
        <div>
          <h2 class="section-title" id="skills-h">Skills</h2>

          <ul class="skills">
            {
              skills.map((s) => (
                <li class="skill reveal">
                  <h3 class="skill__title">{decode(s.category)}</h3>
                  <p class="skill__sub muted">{decode(s.subtitle)}</p>
                  <ul class="tags">
                    {parseTags(s.tags_json).map((t) => (
                      <li class="tag">{decode(t)}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------- Education */}
    <section class="section defer-paint" id="education" aria-labelledby="education-h">
      <div class="rail">
        <p class="eyebrow">Background</p>
        <div>
          <h2 class="section-title" id="education-h">Education</h2>

          {
            education.map((e) => (
              <article class="edu reveal">
                <h3 class="edu__title">{decode(e.title)}</h3>
                <p class="edu__meta">
                  <span>{decode(e.school)}</span>
                  <span class="muted">{decode(e.date_range)}</span>
                </p>
                <div class="edu__body" set:html={e.body_html} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------ Certifications */}
    <section class="section defer-paint" id="certifications" aria-labelledby="certifications-h">
      <div class="rail">
        <p class="eyebrow">Credentials</p>
        <div>
          <h2 class="section-title" id="certifications-h">Certifications</h2>
          <p class="lede">
            Courses and certificates I completed to back up what I already do in practice.
          </p>

          {/* Set like a printed credits list: name left, issuer right, hairline between. */}
          <ul class="certs">
            {
              certifications.map((c) => (
                <li class="cert reveal">
                  <span class="cert__title">{decode(c.title)}</span>
                  <span class="cert__issuer muted">{decode(c.issuer)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------- Blog */}
    <section class="section defer-paint" id="blog" aria-labelledby="blog-h">
      <div class="rail">
        <p class="eyebrow">Writing</p>
        <div>
          <h2 class="section-title" id="blog-h">From the blog</h2>
          <p class="lede">
            Notes on AI automation, social media marketing, and shipping real software with AI
            tools, written from doing the work, not from a marketing deck.
          </p>

          {
            posts.length > 0 && (
              <ul class="posts">
                {posts.map((p) => (
                  <li class="reveal">
                    <a class="post" href={`/blog/${p.slug}`}>
                      <span class="post__cat">{p.category}</span>
                      <span class="post__main">
                        <span class="post__title">{p.title}</span>
                        <span class="post__excerpt muted">{p.excerpt}</span>
                        <span class="post__meta muted">
                          <time datetime={p.post_date}>{dateLabel(p.post_date)}</time>
                          <span aria-hidden="true">&middot;</span>
                          <span>{p.read_time}</span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          <a class="btn" href="/blog/">Read the blog <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------------- FAQ */}
    <section class="section defer-paint" id="faq" aria-labelledby="faq-h">
      <div class="rail">
        <p class="eyebrow">Quick answers</p>
        <div>
          <h2 class="section-title" id="faq-h">Frequently asked</h2>
          <p class="lede">The questions people usually have before reaching out.</p>

          <dl class="faq">
            {
              faqs.map((f) => (
                <div class="faq__item reveal">
                  <dt class="faq__q">{f.q}</dt>
                  <dd class="faq__a" set:html={f.a} />
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- Contact */}
    <section class="section defer-paint" id="contact" aria-labelledby="contact-h">
      <div class="rail">
        <p class="eyebrow">Get in touch</p>
        <div>
          <h2 class="section-title" id="contact-h">Let's talk</h2>
          <p class="lede">
            Whether it is a marketing role, an accounts position, or an automation project that
            needs building properly, I would like to hear about it.
          </p>
          <a class="btn" href="/contact">
            Go to contact page <span aria-hidden="true">&rarr;</span>
          </a>

          {/* The details themselves — labelled rows, no form. The form lives
              on /contact and is not duplicated here. */}
          <dl class="details">
            <div class="details__row">
              <dt class="details__label">Email</dt>
              <dd class="details__val">
                <a class="link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
                <a class="link" href="tel:+9647719620471">+964 (0)771 962 0471</a>
              </dd>
            </div>
            <div class="details__row">
              <dt class="details__label">Social</dt>
              <dd class="details__val details__val--socials">
                {
                  socials.map((s) => (
                    <SocialIcon name={s.name} href={s.url} label={s.label} />
                  ))
                }
              </dd>
            </div>
            <div class="details__row">
              <dt class="details__label">Location</dt>
              <dd class="details__val"><span>Erbil, Iraq</span></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ======================================================================
     Light/dark logo swap.

     IMPORTANT: `.logo-light` is only applied when a dark counterpart exists.
     The previous rule hid every light mark in dark mode, so Help Tech and
     YourVisio — which have no dark variant in D1 — vanished completely.
     Marks without a counterpart keep the neutral `.logo-mark` class, are never
     hidden, and sit on a plate (below) so dark ink stays legible on dark paper.
     ====================================================================== */
  .logo-mark {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .logo-dark {
    display: none;
  }

  :root[data-theme='dark'] .logo-light {
    display: none;
  }

  :root[data-theme='dark'] .logo-dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .logo-light {
      display: none;
    }

    :root:not([data-theme='light']) .logo-dark {
      display: block;
    }
  }

  /* ----------------------------------------------------------------------
     Plate: a light, rounded card behind single-variant marks.
     Help Tech's mark is dark ink on transparency and YourVisio's is a dark
     green mark on cream — both need a light ground to read on dark paper.
     Keeping the plate in BOTH themes means the brand colours stay correct
     (an invert filter would turn Help Tech's red into cyan) and the mark
     does not shift appearance between modes.
     ---------------------------------------------------------------------- */
  .job__logo--plate,
  .work__icon--plate {
    background: #faf8f5;
    border: var(--rule) solid var(--rule-color);
    border-radius: var(--radius-md);
    padding: 0.34em;
    box-shadow: var(--shadow);
  }

  /* ======================================================================
     Hero — the one place the type is allowed to shout.
     ====================================================================== */
  .hero {
    padding-top: clamp(var(--space-l), 7vw, var(--space-2xl));
  }

  .hero__name {
    font-size: var(--step-6);
    margin-bottom: var(--space-s);
  }

  /*
    --step-6 bottoms out at 3.81rem (61px). At 320px the shell leaves ~280px of
    measure, and "Al-Bander" at 61px in Sora does not fit it — the hyphen gives
    the browser a break opportunity, so it does not overflow, it does something
    worse: it wraps the accented surname to "Al-" / "Bander" and the name reads
    as broken. One step down at phone widths keeps the intended two-line
    "Ibrahim Maher / Al-Bander" reading. Nothing above 26rem is touched, so the
    hero at desktop is exactly as designed.
  */
  @media (max-width: 26rem) {
    .hero__name {
      font-size: var(--step-5);
    }
  }

  .hero__last {
    color: var(--accent-ink);
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2xs);
  }

  .hero__tagline {
    font-size: var(--step-0);
    margin-bottom: var(--space-l);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    margin-bottom: var(--space-l);
  }

  .hero__lead {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
    /* A hanging rule in the margin — marginalia, not a border-box. */
    border-left: 2px solid var(--accent);
    padding-left: var(--space-m);
    margin-bottom: var(--space-l);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) 0;
    margin: 0;
    padding-top: var(--space-m);
    border-top: var(--rule) solid var(--rule-color);
  }

  .hero__stat {
    flex: 1 1 12rem;
    padding-right: var(--space-m);
  }

  .hero__stat + .hero__stat {
    padding-left: var(--space-m);
    border-left: var(--rule) solid var(--rule-color);
  }

  /*
    The vertical hairline only means anything while the three figures sit on one
    row. Each stat is `flex: 1 1 12rem` (192px, border-box), so all three fit
    until the measure drops below ~576px — i.e. below ~40rem of viewport. Once
    they wrap, a `border-left` on the 2nd and 3rd reads as an indent with a bar
    floating beside nothing. Stacked, the row gap already does the separating.
  */
  @media (max-width: 40rem) {
    .hero__stat + .hero__stat {
      padding-left: 0;
      border-left: 0;
    }

    .hero__stat {
      padding-right: 0;
    }
  }

  .hero__stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--accent-ink);
  }

  .hero__stat-label {
    display: block;
    margin: var(--space-3xs) 0 0;
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--ink-3);
  }

  /* ======================================================================
     Experience — a dated index, the way a CV reads in print.
     ====================================================================== */
  .jobs {
    margin-top: var(--space-l);
  }

  .job {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-top: var(--rule) solid var(--rule-color);
  }

  .job:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .job__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
  }

  .job__index {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
    letter-spacing: var(--tracking-wide);
  }

  /* 1.5x the original 44px. The plate adds padding around this box, so the
     mark itself stays 66px and the plate reads slightly larger. */
  .job__logo {
    display: grid;
    place-items: center;
    flex: none;
  }

  .job__logo img {
    width: 66px;
    height: 66px;
    object-fit: contain;
  }

  .job__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-3xs);
  }

  .job__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    align-items: baseline;
    font-size: var(--step--1);
    color: var(--ink-3);
    margin-bottom: var(--space-s);
  }

  .job__date {
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
  }

  .job__date::before {
    content: '\2014';
    margin-right: var(--space-2xs);
  }

  .job__body,
  .work__body,
  .headline__body,
  .edu__body {
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .job__body :global(p:last-child),
  .work__body :global(p:last-child),
  .headline__body :global(p:last-child),
  .edu__body :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 40rem) {
    .job {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }

    .job__aside {
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }
  }

  /* ======================================================================
     Projects — DAD LINK as the headline, the n8n workflows beneath it.

     The hierarchy is carried by three things at once, not one: DAD LINK comes
     first, it is the only thing on a raised surface, and its title is set two
     steps larger than the workflow titles. Any one of those alone would be
     ambiguous next to three big screenshots.
     ====================================================================== */
  .headline {
    position: relative;
    margin-top: var(--space-l);
    padding: clamp(var(--space-m), 4vw, var(--space-xl));
    background: var(--surface);
    border: var(--rule) solid var(--rule-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: box-shadow var(--dur-slow) var(--ease-settle);
  }

  /* The accent edge from the old featured block, kept — but now riding inside
     the panel's radius instead of being a bare rule across the page. */
  .headline::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent);
  }

  /* A 48px-blur shadow transition is a full re-raster of the panel on every
     frame. It is worth it on a desktop pointer; on a phone it can never be
     triggered by a real hover, only by tap emulation, so it is gated out. */
  @media (hover: hover) {
    .headline:hover {
      box-shadow:
        0 2px 4px rgba(22, 19, 15, 0.05),
        0 18px 48px rgba(22, 19, 15, 0.1);
    }
  }

  .headline__eyebrow {
    color: var(--accent-ink);
  }

  .headline__logo {
    width: 120px;
    height: auto;
    object-fit: contain;
    margin-bottom: var(--space-m);
  }

  /* Two steps above .work__title — this is the thing that has to read first. */
  .headline__title {
    font-size: var(--step-4);
    max-width: var(--measure-narrow);
    margin-bottom: var(--space-m);
    /* "…network infrastructure equipment…" at --step-4 is wider than a 320px
       viewport minus the panel padding. Without this the single word pushes the
       body into horizontal scroll. */
    overflow-wrap: break-word;
  }

  .headline__link {
    text-decoration: none;
    color: inherit;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-slow) var(--ease-settle);
  }

  /*
     Deliberately NOT a stretched link, unlike the workflow cards.
     An overlay spanning the panel would swallow pointer events over three
     paragraphs of prose, making the copy impossible to select. The workflow
     cards are short and image-led so they can afford it; this one cannot.
     The title and the explicit visit link are both real anchors here.
  */
  .headline__link:focus-visible {
    background-size: 100% 2px;
  }

  @media (hover: hover) {
    .headline:hover .headline__link {
      background-size: 100% 2px;
    }
  }

  .headline__body {
    font-size: var(--step-1);
