    width: 100%;
    height: auto;
    /* Reserves the box before the lazy image lands — no CLS. Must match the
       real 1400x783 asset; a wrong ratio letterboxes or crops it. */
    aspect-ratio: 1400 / 783;
    object-fit: cover;
    /* Fills the reserved box while the image is in flight, so the frame reads
       as a deliberate surface rather than a hole. */
    background-color: var(--paper-2);
    border-radius: var(--radius-md);
    /*
      The transform on this element belongs to `.settle-in`'s scroll-driven
      animation (see global.css). Deliberately no hover transform here: a filled
      scroll animation holds its final value and would beat the transition, so a
      hover scale would simply never fire. The card's hover reads through the
      frame's shadow, the underline and the arrow instead.
    */
  }

  /* ----------------------------------------------------------------------
