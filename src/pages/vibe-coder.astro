---
export const prerender = false;

import Base from '../layouts/Base.astro';
import '../styles/landing.css';

/*
  Service page targeting "vibe coder" in Erbil / Iraq / Kurdistan. Differentiated
  from the two automation pages: this is about BUILDING SOFTWARE (web apps, sites,
  internal tools, AI features) fast with AI-assisted development — not workflows or
  agents. Proof leans on DAD LINK (a shipped B2B store) and this site itself.
  Distinct title/description/H1/@id/FAQ; shares the Person entity (@id #ibrahim).
*/

const title = 'Vibe Coder in Erbil, Iraq | Ibrahim Al-Bander';
const description =
  'Hire a vibe coder in Erbil, Iraq. I build real web apps, sites, and internal tools fast with AI-assisted development for clients in Iraq, the Kurdistan Region, and worldwide.';
const keywords =
  'vibe coder Erbil, vibe coder Iraq, vibe coder Kurdistan, vibe coding developer, AI-assisted developer Erbil, hire a vibe coder, AI app developer Iraq, vibe coding Iraq';

// FAQ defined once; the visible <dl> and the FAQPage JSON-LD render from the same
// text so they cannot drift.
const faqs = [
  {
    q: 'What is vibe coding?',
    a: 'Vibe coding is building software by working with AI models instead of typing every line by hand — you describe what you want, the model drafts it, and you steer, review, and correct until it is right. Done seriously it is not blind copy-paste: I read every change, test it, and harden it before it ships. It is a faster way to build, not a way to skip understanding the code.',
  },
  {
    q: 'Is software built this way actually reliable?',
    a: 'It is as reliable as the person steering it. AI speeds up the typing; the engineering — reading the output, testing edge cases, handling errors, and thinking about security — is still on me. I ship production software this way, including a live B2B e-commerce store and this very website, both running in the real world, not a demo.',
  },
  {
    q: 'What can you build for me?',
    a: 'Web apps and websites, internal tools and dashboards, AI features and integrations, and quick MVPs to test an idea before you commit to it. If it runs in a browser or talks to an API, it is in scope. If it is closer to automating a repetitive process, I also work as an n8n and AI automation developer.',
  },
  {
    q: 'Do you build entirely with AI, or write code by hand too?',
    a: 'Both, wherever each is the right tool. AI handles the boilerplate and the first draft fast; I write and rewrite the parts that need real judgement by hand. The client cares about a working, maintainable result — not which lines a model suggested — and that is what I deliver.',
  },
  {
    q: 'Can you work with clients outside Erbil and Iraq?',
    a: 'Yes. The work is delivered remotely, so I build for clients anywhere in the world, alongside in-person work for businesses in Erbil and across the Kurdistan Region and Iraq.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://ibrahimaher.com/#vibe-coding-service',
    name: 'Ibrahim Al-Bander — AI-Assisted Software Development',
    url: 'https://ibrahimaher.com/vibe-coder',
    image: 'https://ibrahimaher.com/assets/og/default.png',
    description:
      'AI-assisted software development ("vibe coding") in Erbil, Iraq: web apps, websites, internal tools, AI features, and MVPs built fast with AI and shipped to production, for clients across Erbil, the Kurdistan Region, Iraq, and remotely worldwide.',
    provider: {
      '@type': 'Person',
      '@id': 'https://ibrahimaher.com/#ibrahim',
      name: 'Ibrahim Maher Al-Bander',
      url: 'https://ibrahimaher.com',
    },
    areaServed: [
      { '@type': 'City', name: 'Erbil' },
      { '@type': 'AdministrativeArea', name: 'Kurdistan Region' },
      { '@type': 'Country', name: 'Iraq' },
      'Worldwide (remote)',
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Erbil',
      addressRegion: 'Kurdistan Region',
      addressCountry: 'IQ',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 36.1901, longitude: 44.0091 },
    telephone: '+9647719620471',
    email: 'mailto:me@ibrahimaher.com',
    priceRange: '$$',
    knowsLanguage: ['en', 'ar', 'ckb'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'AI-assisted development services',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Web apps & websites',
            serviceType: 'Web application development',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Internal tools & dashboards',
            serviceType: 'Custom software development',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'AI features & integrations',
            serviceType: 'AI feature development',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'MVPs & prototypes',
            serviceType: 'Prototype development',
          },
        },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ibrahimaher.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Hire a vibe coder',
        item: 'https://ibrahimaher.com/vibe-coder',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={title} description={description} keywords={keywords} ogType="website" jsonLd={jsonLd}>
  <div class="shell lp">
    <section class="section hero stagger" aria-labelledby="svc-h">
      <p class="eyebrow" style="--i:0">Work with me</p>
      <h1 class="hero__name" id="svc-h" style="--i:1">
        Vibe Coder<br /><span class="hero__last">in Erbil, Iraq</span>
      </h1>
      <p class="hero__role" style="--i:2">AI-assisted web apps, websites, and internal tools, built fast</p>
      <p class="hero__tagline muted" style="--i:3">
        For businesses in Erbil, the Kurdistan Region, and across Iraq &middot; and remote clients
        worldwide
      </p>
      <div class="hero__actions" style="--i:4">
        <a class="btn" href="/contact">Get a fixed quote</a>
        <a class="btn btn-ghost" href="/#projects">See the work <span aria-hidden="true">&rarr;</span></a>
      </div>
      <p class="hero__lead" style="--i:5">
        I'm Ibrahim Al-Bander, a vibe coder and AI-assisted developer in Erbil, Iraq. I build real,
        working software &mdash; web apps, sites, internal tools, and AI features &mdash; fast, by
        pairing with AI models and then reviewing, testing, and hardening every line before it ships.
        The proof is live: a B2B e-commerce store and this website itself. I work in person across
        Erbil and the Kurdistan Region, and remotely worldwide.
      </p>
    </section>

    <section class="section" aria-labelledby="what-h">
      <div class="rail">
        <p class="eyebrow">The short version</p>
        <div>
          <h2 class="section-title" id="what-h">What is vibe coding?</h2>
          <p class="lede">
            Vibe coding means building software with AI instead of typing every line by hand: you
            describe what you want, the model drafts it, and you steer, review, and correct until it
            is right. Done seriously it is not blind copy-paste &mdash; the engineering judgement,
            testing, and hardening are still the developer's job. It is simply a much faster way to
            get a real, working product built.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="build-h">
      <div class="rail">
        <p class="eyebrow">Services</p>
        <div>
          <h2 class="section-title" id="build-h">What I build</h2>
          <p class="lede">
            Real software you can put in front of customers or your team &mdash; shipped fast, then
            tested and hardened so it holds up.
          </p>
          <ul class="skills">
            <li class="skill reveal">
              <h3 class="skill__title">Web apps &amp; websites</h3>
              <p class="skill__sub muted">The public-facing product</p>
              <ul class="tags">
                <li class="tag">Landing &amp; marketing sites</li>
                <li class="tag">E-commerce</li>
                <li class="tag">Web apps</li>
                <li class="tag">Fast &amp; responsive</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title">Internal tools &amp; dashboards</h3>
              <p class="skill__sub muted">The software your team actually uses</p>
              <ul class="tags">
                <li class="tag">Admin panels</li>
                <li class="tag">Dashboards</li>
                <li class="tag">Data entry &amp; reporting</li>
                <li class="tag">Custom CMS</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title">AI features &amp; integrations</h3>
              <p class="skill__sub muted">Putting a model inside your product</p>
              <ul class="tags">
                <li class="tag">Chat &amp; assistants</li>
                <li class="tag">OpenAI / Claude / Gemini</li>
                <li class="tag">API integrations</li>
                <li class="tag">Automation hooks</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title">MVPs &amp; prototypes</h3>
              <p class="skill__sub muted">Test the idea before you commit</p>
              <ul class="tags">
                <li class="tag">Rapid builds</li>
                <li class="tag">Proof of concept</li>
                <li class="tag">Iteration</li>
                <li class="tag">Ship in days</li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="how-h">
      <div class="rail">
        <p class="eyebrow">How it works</p>
        <div>
          <h2 class="section-title" id="how-h">How I actually build with AI</h2>
          <p class="lede">
            Fast does not mean careless. Read how I taught myself to
            <a class="link" href="/blog/ai-assisted-development-no-cs-degree"
              >ship real software without a CS degree</a
            >.
          </p>
          <ol class="disciplines">
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">01</span>
              <div class="discipline__main">
                <h3 class="discipline__term">Scope it clearly</h3>
                <p class="discipline__def">
                  We agree exactly what the thing does before a line is written. A clear spec is what
                  lets AI move fast without wandering off and building the wrong product.
                </p>
              </div>
            </li>
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">02</span>
              <div class="discipline__main">
                <h3 class="discipline__term">Build fast with AI</h3>
                <p class="discipline__def">
                  I pair with AI models to draft the app quickly, then read every change and rewrite
                  by hand the parts that need real judgement. The speed is the AI; the decisions are
                  mine.
                </p>
              </div>
            </li>
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">03</span>
              <div class="discipline__main">
                <h3 class="discipline__term">Review, test &amp; harden</h3>
                <p class="discipline__def">
                  Edge cases, error handling, and security get tested against real inputs, not the
                  happy path. This is the step that separates a working product from a demo.
                </p>
              </div>
            </li>
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">04</span>
              <div class="discipline__main">
                <h3 class="discipline__term">Ship to production</h3>
                <p class="discipline__def">
                  It goes live on real infrastructure, documented so you or your team can run and
                  extend it &mdash; not left as a prototype nobody can maintain.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="cost-h">
      <div class="rail">
        <p class="eyebrow">Pricing</p>
        <div>
          <h2 class="section-title" id="cost-h">How much does it cost?</h2>
          <p class="lede">
            Projects are quoted fixed-price after a short scoping conversation, not billed by the
            hour &mdash; so you know the number before anything starts. A small tool or MVP is a
            focused build; a full site or app depends on the features, integrations, and how polished
            it needs to be. Tell me what you want to build and I will give you a fixed quote.
          </p>
          <div class="hero__actions">
            <a class="btn" href="/contact">Tell me what to build</a>
            <a class="btn btn-ghost" href="/ai-automation-developer"
              >Hire me for AI automation <span aria-hidden="true">&rarr;</span></a
            >
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="who-h">
      <div class="rail">
        <p class="eyebrow">Who I work with</p>
        <div>
          <h2 class="section-title" id="who-h">Local in Erbil, remote worldwide</h2>
          <p class="lede">
            Founders, small businesses, and teams who need real software without a full agency budget
            or a six-month timeline: in person around Erbil and the Kurdistan Region, and remotely
            across Iraq and worldwide. AI-assisted development is how one person can ship what used to
            take a team &mdash; and ship it fast.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="proof-h">
      <div class="rail">
        <p class="eyebrow">Proof</p>
        <div>
          <h2 class="section-title" id="proof-h">Real, shipped software</h2>
          <p class="lede">
            <a href="https://www.dad-link.com" target="_blank" rel="noopener">DAD LINK</a> is a live
            B2B e-commerce store for network infrastructure equipment in Iraq that I designed and
            shipped &mdash; a real storefront, not a template. And this website itself is built on
            Astro and Cloudflare Workers with a custom admin CMS I wrote. Both are in production.
            <a href="/#projects">See the Projects section</a> for the automation work too.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="svc-faq-h">
      <div class="rail">
        <p class="eyebrow">Quick answers</p>
        <div>
          <h2 class="section-title" id="svc-faq-h">Hiring a vibe coder: FAQ</h2>
          <dl class="faq">
            {
              faqs.map((f) => (
                <div class="faq__item reveal">
                  <dt class="faq__q">{f.q}</dt>
                  <dd class="faq__a">{f.a}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="svc-contact-h">
      <div class="rail">
        <p class="eyebrow">Get in touch</p>
        <div>
          <h2 class="section-title" id="svc-contact-h">Let's build something</h2>
          <p class="lede">
            Tell me what you want to build &mdash; an app, a site, an internal tool, or a quick
            prototype to test an idea. I will tell you whether it is a fit and what it would cost.
          </p>
          <a class="btn" href="/contact">Go to contact page <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    <nav class="svc-links" aria-label="Related services">
      <span class="svc-links__label">Also</span>
      <a class="link" href="/n8n-developer">Hire an n8n developer</a>
      <a class="link" href="/ai-automation-developer">Hire an AI automation developer</a>
    </nav>
  </div>
</Base>
