---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import '../../styles/landing.css';
import { altLocalesFor } from '../../lib/i18n';
import { IRAQ_AREA_SERVED, ARABIC_SERVICE_OFFERS } from '../../lib/schema-geo';

/*
  Arabic homepage.

  Deliberately NOT a translation of the English homepage. That one is a resume —
  experience, education, certifications — because its job is to answer "who is
  Ibrahim Al-Bander" for people who already know the name. Nobody in Baghdad
  searches an Iraqi freelancer's CV in Arabic; they search for someone who can
  automate a process. So the Arabic root is a commercial hub: what the service
  is, who it is for, and three routes into the service pages.

  This still pairs honestly for hreflang. The two are the same PAGE in the site's
  structure — the entry point for their language — which is what hreflang pairs,
  rather than requiring identical content.
*/

const title = 'أتمتة الذكاء الاصطناعي وروبوتات الدردشة للشركات في العراق | إبراهيم البندر';
const description =
  'مطوّر أتمتة وذكاء اصطناعي في العراق. روبوتات دردشة لواتساب وإنستغرام، وسير عمل آلي بـ n8n، وأتمتة الفواتير والعملاء، لشركات بغداد وأربيل والبصرة والموصل.';
const keywords =
  'أتمتة الذكاء الاصطناعي العراق, شات بوت العراق, مطور n8n العراق, أتمتة الأعمال بغداد, ذكاء اصطناعي للشركات, أتمتة واتساب, مطور أتمتة أربيل';

const canonical = '/ar/';
const altLocales = altLocalesFor(canonical);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://ibrahimaher.com/#service-home-ar',
    name: 'إبراهيم البندر لأتمتة الذكاء الاصطناعي في العراق',
    url: 'https://ibrahimaher.com/ar/',
    image: 'https://ibrahimaher.com/assets/og-image.png',
    inLanguage: 'ar-IQ',
    description:
      'أتمتة الذكاء الاصطناعي وتطوير روبوتات الدردشة وسير العمل الآلي للشركات في العراق، من أربيل وإلى عموم المحافظات، وعن بُعد حول العالم.',
    provider: {
      '@type': 'Person',
      '@id': 'https://ibrahimaher.com/#ibrahim',
      name: 'إبراهيم ماهر البندر',
      url: 'https://ibrahimaher.com',
    },
    areaServed: IRAQ_AREA_SERVED,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'أربيل',
      addressRegion: 'إقليم كردستان',
      addressCountry: 'IQ',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 36.1901, longitude: 44.0091 },
    telephone: '+9647719620471',
    email: 'mailto:me@ibrahimaher.com',
    priceRange: '$$',
    makesOffer: ARABIC_SERVICE_OFFERS,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'ar-IQ',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'ما الذي يمكن أتمتته في الشركات؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'أي عملية متكررة واضحة الخطوات: الرد على رسائل العملاء على واتساب وإنستغرام، وقراءة فواتير الموردين واستخراج بياناتها، وملاحقة موافقات الدفع، وتقييم العملاء المحتملين وتوجيههم إلى المبيعات، ومزامنة البيانات بين الأنظمة، وإرسال التقارير الدورية. والقاعدة العملية أنه إذا كرر أحدهم العمل نفسه أكثر من مرة في الأسبوع فالأرجح أن أتمتته ممكنة.',
        },
      },
      {
        '@type': 'Question',
        name: 'هل تعمل مع شركات في بغداد والبصرة والموصل؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'نعم. مقرّي أربيل وأعمل حضورياً مع الشركات هناك، لكن الأتمتة تُسلَّم عن بُعد بالكامل، لذلك أعمل مع شركات في بغداد والبصرة والموصل والسليمانية والنجف وكربلاء وكركوك ودهوك وبقية المحافظات، ومع عملاء دوليين.',
        },
      },
      {
        '@type': 'Question',
        name: 'من أين أبدأ إذا لم أستخدم الذكاء الاصطناعي من قبل؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'ابدأ بأصغر عملية مرهقة لديك، وهي غالباً الرد على رسائل العملاء. روبوت محدود النطاق يغطي الأسئلة المتكررة يعطي نتيجة ملموسة خلال أيام دون أن يغيّر طريقة عمل فريقك، ومنه يمكن التوسع تدريجياً إلى قراءة المستندات والموافقات.',
        },
      },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  keywords={keywords}
  ogType="website"
  jsonLd={jsonLd}
  lang="ar"
  altLocales={altLocales}
>
  <div class="shell lp">
    <section class="section hero stagger" aria-labelledby="home-h">
      <p class="eyebrow" style="--i:0">إبراهيم ماهر البندر</p>
      <h1 class="hero__name" id="home-h" style="--i:1">
        أتمتة الذكاء الاصطناعي<br /><span class="hero__last">للشركات في العراق</span>
      </h1>
      <p class="hero__role" style="--i:2">روبوتات دردشة، وسير عمل آلي، وأنظمة تعمل دون إشراف</p>
      <p class="hero__tagline muted" style="--i:3">
        من أربيل إلى بغداد والبصرة والموصل والسليمانية &middot; وعن بُعد حول العالم
      </p>
      <div class="hero__actions" style="--i:4">
        <a class="btn" href="/ar/contact">اطلب عرض سعر ثابت</a>
        <a class="btn btn-ghost" href="/ar/ai-automation-developer"
          >روبوتات الدردشة والذكاء الاصطناعي <span aria-hidden="true">&larr;</span></a
        >
      </div>
      <p class="hero__lead" style="--i:5">
        أبني أنظمة تُنهي العمل المتكرر بدل أن تعرضه في صورة جميلة. روبوت يرد على عملائك خلال ثوانٍ،
        ونماذج تقرأ الفواتير وتستخرج بياناتها، وسير عمل يلاحق الموافقات ويعدّ التقارير. أعمل حضورياً
        في أربيل، وعن بُعد مع شركات في عموم العراق.
      </p>
    </section>

    <section class="section" aria-labelledby="svc-h">
      <div class="rail">
        <p class="eyebrow">الخدمات</p>
        <div>
          <h2 class="section-title" id="svc-h">ثلاث طرق للعمل معي</h2>
          <p class="lede">
            كل مشروع يبدأ بعملية حقيقية في شركتك، وينتهي بنظام مسلَّم وموثّق بسعر ثابت متفق عليه مسبقاً.
          </p>
          <ul class="skills">
            <li class="skill reveal">
              <h3 class="skill__title">
                <a href="/ar/ai-automation-developer">أتمتة الذكاء الاصطناعي وروبوتات الدردشة</a>
              </h3>
              <p class="skill__sub muted">الأكثر طلباً لدى الشركات العراقية</p>
              <ul class="tags">
                <li class="tag">واتساب وإنستغرام</li>
                <li class="tag">رد تلقائي</li>
                <li class="tag">قراءة المستندات</li>
                <li class="tag">تقييم العملاء</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title"><a href="/ar/n8n-developer">أتمتة سير العمل</a></h3>
              <p class="skill__sub muted">ربط أنظمتك ببعضها</p>
              <ul class="tags">
                <li class="tag">سير عمل متعدد الخطوات</li>
                <li class="tag">أتمتة الفواتير</li>
                <li class="tag">مسارات الموافقات</li>
                <li class="tag">تقارير تلقائية</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title"><a href="/ar/vibe-coder">بناء المواقع والتطبيقات</a></h3>
              <p class="skill__sub muted">تطوير سريع بمساعدة الذكاء الاصطناعي</p>
              <ul class="tags">
                <li class="tag">مواقع وتطبيقات</li>
                <li class="tag">أدوات داخلية</li>
                <li class="tag">متاجر إلكترونية</li>
                <li class="tag">نماذج أولية</li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="why-h">
      <div class="rail">
        <p class="eyebrow">لماذا الآن</p>
        <div>
          <h2 class="section-title" id="why-h">ما الذي يمكن أتمتته فعلاً؟</h2>
          <p class="lede">
            القاعدة العملية بسيطة: إذا كان أحد أفراد فريقك يكرر العمل نفسه أكثر من مرة في الأسبوع،
            فالأرجح أن أتمتته ممكنة. الرد على الأسئلة المتكررة، وإدخال بيانات الفواتير، وملاحقة
            الموافقات، ونقل الأرقام بين جدول ونظام، وإعداد التقرير الأسبوعي. هذه أعمال لا تحتاج إلى
            ذكاء بشري، لكنها تستهلك ساعات وتكثر فيها الأخطاء، وهي أولى ما ينبغي أن يختفي.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="proof-h">
      <div class="rail">
        <p class="eyebrow">إثبات</p>
        <div>
          <h2 class="section-title" id="proof-h">أعمال حقيقية، لا شرائح عرض</h2>
          <p class="lede">
            جدار حماية الفواتير من التلاعب، ونظام تقييم العملاء المحتملين بالذكاء الاصطناعي، ومسار
            الموافقات متعدد المراحل، إضافة إلى
            <a href="https://www.dad-link.com" target="_blank" rel="noopener">DAD LINK</a>، وهو متجر
            إلكتروني عامل بين الشركات لمعدات البنية التحتية للشبكات في العراق، صمّمته وأطلقته بنفسي.
            والتفاصيل الكاملة في <a href="/#projects">قسم المشاريع</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-h">
      <div class="rail">
        <p class="eyebrow">إجابات سريعة</p>
        <div>
          <h2 class="section-title" id="faq-h">أسئلة شائعة</h2>
          <dl class="faq">
            <div class="faq__item reveal">
              <dt class="faq__q">هل تعمل مع شركات في بغداد والبصرة والموصل؟</dt>
              <dd class="faq__a">
                نعم. مقرّي أربيل، لكن الأتمتة تُسلَّم عن بُعد بالكامل، لذلك أعمل مع شركات في بغداد
                والبصرة والموصل والسليمانية والنجف وكربلاء وكركوك ودهوك، ومع عملاء دوليين.
              </dd>
            </div>
            <div class="faq__item reveal">
              <dt class="faq__q">من أين أبدأ إذا لم أستخدم الذكاء الاصطناعي من قبل؟</dt>
              <dd class="faq__a">
                ابدأ بأصغر عملية مرهقة لديك، وهي غالباً الرد على رسائل العملاء. روبوت محدود النطاق يعطي
                نتيجة ملموسة خلال أيام، ومنه يمكن التوسع تدريجياً.
              </dd>
            </div>
            <div class="faq__item reveal">
              <dt class="faq__q">كيف يتم التسعير؟</dt>
              <dd class="faq__a">
                سعر ثابت لكل مشروع، متفق عليه قبل بدء العمل، مع تقدير لتكلفة التشغيل الشهرية حتى لا
                تفاجئك فاتورة لاحقاً.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="contact-h">
      <div class="rail">
        <p class="eyebrow">تواصل</p>
        <div>
          <h2 class="section-title" id="contact-h">لنبدأ بعملية واحدة</h2>
          <p class="lede">
            أخبرني بالعملية التي تستهلك وقت فريقك. سأخبرك إن كان بالإمكان إزالتها، وكم ستكلّف.
          </p>
          <a class="btn" href="/ar/contact"
            >اذهب إلى صفحة التواصل <span aria-hidden="true">&larr;</span></a
          >
        </div>
      </div>
    </section>
  </div>
</Base>
