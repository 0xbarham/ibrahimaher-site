---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import '../../styles/landing.css';
import { altLocalesFor } from '../../lib/i18n';
import { IRAQ_AREA_SERVED, ARABIC_SERVICE_OFFERS } from '../../lib/schema-geo';

/*
  Arabic counterpart of /n8n-developer.

  Deliberately not a translation of the English page. The English one sells to a
  reader who already knows what n8n is and searches for it by name; the Arabic
  market overwhelmingly searches the OUTCOME ("أتمتة الأعمال", "شات بوت واتساب")
  rather than the tool. So this copy leads with the problem and introduces n8n as
  the answer, and the headings target the phrases people actually type. Same
  offer, same proof, different entry point.
*/

const title = 'مطوّر n8n وأتمتة الذكاء الاصطناعي في العراق | إبراهيم البندر';
const description =
  'مطوّر n8n وأتمتة الذكاء الاصطناعي في العراق. أبني سير عمل آلي، ووكلاء ذكاء اصطناعي، وأتمتة للفواتير والعملاء المحتملين لشركات بغداد وأربيل والبصرة والموصل.';
const keywords =
  'مطور n8n العراق, أتمتة الذكاء الاصطناعي العراق, أتمتة الأعمال بغداد, مطور أتمتة أربيل, سير عمل آلي, أتمتة الشركات العراق, وكلاء الذكاء الاصطناعي';

const canonical = '/ar/n8n-developer';
const altLocales = altLocalesFor(canonical);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://ibrahimaher.com/#service-ar',
    name: 'إبراهيم البندر لتطوير n8n وأتمتة الذكاء الاصطناعي',
    url: 'https://ibrahimaher.com/ar/n8n-developer',
    image: 'https://ibrahimaher.com/assets/og-image.png',
    inLanguage: 'ar-IQ',
    description:
      'تطوير n8n وأتمتة الذكاء الاصطناعي في العراق. سير عمل إنتاجي، ووكلاء ذكاء اصطناعي، وأتمتة الفواتير والعملاء المحتملين، وأتمتة العمليات لشركات في بغداد وأربيل والبصرة والموصل والسليمانية، وعن بُعد حول العالم.',
    provider: {
      '@type': 'Person',
      '@id': 'https://ibrahimaher.com/#ibrahim',
      name: 'إبراهيم ماهر البندر',
      url: 'https://ibrahimaher.com',
    },
    areaServed: IRAQ_AREA_SERVED,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'أربيل',
      addressRegion: 'إقليم كردستان',
      addressCountry: 'IQ',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 36.1901, longitude: 44.0091 },
    telephone: '+9647719620471',
    email: 'mailto:me@ibrahimaher.com',
    priceRange: '$$',
    makesOffer: ARABIC_SERVICE_OFFERS,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://ibrahimaher.com/ar/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'مطوّر n8n',
        item: 'https://ibrahimaher.com/ar/n8n-developer',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'ar-IQ',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'كيف أوظّف مطوّر n8n في العراق؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'تواصل معي مباشرة عبر الموقع واشرح العملية التي تريد أتمتتها بجملتين. أحدّد نطاق العمل، وأعطيك سعراً ثابتاً قبل أن يبدأ أي عمل، ثم أبني سير العمل وأختبره في n8n وأسلّمه موثّقاً وجاهزاً للتشغيل. أعمل حضورياً مع الشركات في أربيل، وعن بُعد مع عملاء في بغداد والبصرة والموصل والسليمانية وبقية العراق والعالم.',
        },
      },
      {
        '@type': 'Question',
        name: 'ما هي تكلفة أتمتة n8n؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'التسعير يكون لكل سير عمل أو لكل مشروع، وليس بالساعة. عالمياً يتقاضى مطورو n8n المستقلون ما بين 40 و100 دولار للساعة تقريباً، وبناء سير عمل واحد مركّز يكلف عادة بضع مئات من الدولارات حسب عدد الخطوات والتكاملات ومنطق الذكاء الاصطناعي. تحصل على سعر ثابت قبل بدء العمل.',
        },
      },
      {
        '@type': 'Question',
        name: 'هل تعمل مع شركات خارج أربيل؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'نعم. أتمتة n8n تُسلَّم عن بُعد بالكامل، لذلك أعمل مع شركات في بغداد والبصرة والموصل والسليمانية والنجف وكربلاء وبقية محافظات العراق، ومع عملاء دوليين أيضاً. الاجتماعات تتم عبر الإنترنت والتسليم رقمي.',
        },
      },
      {
        '@type': 'Question',
        name: 'ما هي الأدوات ونماذج الذكاء الاصطناعي التي تعمل بها؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'n8n كمنصة أتمتة، موصولة بأدوات مثل Gmail وGoogle Sheets وGoogle Calendar وTelegram وGoHighLevel، وبنماذج ذكاء اصطناعي منها OpenAI وClaude وGemini. وعندما لا تكفي العُقد الجاهزة في n8n أكتب عُقد JavaScript مخصصة.',
        },
      },
      {
        '@type': 'Question',
        name: 'هل يمكنك إصلاح أو استلام سير عمل n8n موجود مسبقاً؟',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'نعم. أستطيع مراجعة سير عمل قائم وتصحيحه وتوسيعه أو استلامه بالكامل، وإضافة التحقق من البيانات والتسجيل حتى يتوقف عن الفشل بصمت، وتوثيقه حتى لا يعتمد فريقك على شخص واحد.',
        },
      },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  keywords={keywords}
  ogType="website"
  jsonLd={jsonLd}
  lang="ar"
  altLocales={altLocales}
>
  <div class="shell lp">
    <section class="section hero stagger" aria-labelledby="svc-h">
      <p class="eyebrow" style="--i:0">اعمل معي</p>
      <h1 class="hero__name" id="svc-h" style="--i:1">
        مطوّر <span lang="en">n8n</span> وأتمتة<br /><span class="hero__last"
          >الذكاء الاصطناعي في العراق</span
        >
      </h1>
      <p class="hero__role" style="--i:2">سير عمل إنتاجي، ووكلاء ذكاء اصطناعي، وأتمتة عمليات</p>
      <p class="hero__tagline muted" style="--i:3">
        لشركات بغداد وأربيل والبصرة والموصل والسليمانية &middot; وعن بُعد حول العالم
      </p>
      <div class="hero__actions" style="--i:4">
        <a class="btn" href="/ar/contact">اطلب عرض سعر ثابت</a>
        <a class="btn btn-ghost" href="/#projects">شاهد الأعمال <span aria-hidden="true">&larr;</span></a>
      </div>
      <p class="hero__lead" style="--i:5">
        أنا إبراهيم البندر، مطوّر <span lang="en">n8n</span> وأتمتة ذكاء اصطناعي مقيم في أربيل وأعمل مع
        شركات في عموم العراق. أبني أنظمة أتمتة إنتاجية تعمل دون إشراف ولا تتعطل بصمت: تقييم العملاء
        المحتملين بالذكاء الاصطناعي، ومعالجة الفواتير والمستندات، وكشف التلاعب، ومسارات الموافقات،
        والتقارير الدورية.
      </p>
    </section>

    <section class="section" aria-labelledby="what-h">
      <div class="rail">
        <p class="eyebrow">باختصار</p>
        <div>
          <h2 class="section-title" id="what-h">ما الذي يفعله مطوّر <span lang="en">n8n</span>؟</h2>
          <p class="lede">
            مطوّر <span lang="en">n8n</span> يصمم ويبني ويصون سير عمل آلياً يربط تطبيقاتك وبياناتك
            ونماذج الذكاء الاصطناعي، بحيث يحدث العمل المتكرر من تلقاء نفسه. عملياً يعني ذلك ربط أدوات
            مثل البريد وجداول البيانات والتقويم وتيليغرام وأنظمة إدارة العملاء بنماذج مثل
            <span lang="en">OpenAI</span> و<span lang="en">Claude</span> و<span lang="en">Gemini</span>،
            ثم إضافة التحقق والتسجيل الذي يجعل الأتمتة جديرة بالثقة في بيئة الإنتاج. وإذا نُفّذ العمل
            على وجهه الصحيح فإنه يوفّر ساعات من العمل اليدوي كل أسبوع، دون أن يضيف نظاماً جديداً
            يحتاج فريقك إلى مراقبته.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="build-h">
      <div class="rail">
        <p class="eyebrow">الخدمات</p>
        <div>
          <h2 class="section-title" id="build-h">ما الذي أبنيه بـ<span lang="en">n8n</span></h2>
          <p class="lede">
            أنظمة أتمتة مركّزة وجاهزة للإنتاج، مبنية على عملية حقيقية في شركتك لا على عرض تقديمي لامع.
          </p>
          <ul class="skills">
            <li class="skill reveal">
              <h3 class="skill__title">أتمتة سير العمل</h3>
              <p class="skill__sub muted">جوهر ما أقوم به</p>
              <ul class="tags">
                <li class="tag">سير عمل متعدد الخطوات</li>
                <li class="tag">واجهات برمجية</li>
                <li class="tag">معالجة الأخطاء</li>
                <li class="tag">التحقق من البيانات</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title">وكلاء الذكاء الاصطناعي والشات بوت</h3>
              <p class="skill__sub muted">نماذج تقرأ وتحكم وترد</p>
              <ul class="tags">
                <li class="tag">تقييم العملاء المحتملين</li>
                <li class="tag">استخراج بيانات المستندات</li>
                <li class="tag">الرد التلقائي</li>
                <li class="tag">واتساب وإنستغرام</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title">أتمتة الفواتير والمبيعات</h3>
              <p class="skill__sub muted">المالية والمبيعات على الطيار الآلي</p>
              <ul class="tags">
                <li class="tag">معالجة الفواتير</li>
                <li class="tag">كشف التلاعب</li>
                <li class="tag">مسارات الموافقات</li>
                <li class="tag">مزامنة العملاء</li>
              </ul>
            </li>
            <li class="skill reveal">
              <h3 class="skill__title">أتمتة العمليات</h3>
              <p class="skill__sub muted">إزالة العمل المتكرر الممل</p>
              <ul class="tags">
                <li class="tag">تقارير تلقائية</li>
                <li class="tag">مزامنة البيانات</li>
                <li class="tag">الإشعارات</li>
                <li class="tag">عُقد برمجية مخصصة</li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="cost-h">
      <div class="rail">
        <p class="eyebrow">التسعير</p>
        <div>
          <h2 class="section-title" id="cost-h">كم تكلفة أتمتة <span lang="en">n8n</span>؟</h2>
          <p class="lede">
            التسعير عادةً لكل سير عمل أو لكل مشروع، لا بالساعة. عالمياً يتقاضى مطورو
            <span lang="en">n8n</span> المستقلون ما بين 40 و100 دولار للساعة تقريباً، وبناء سير عمل
            واحد مركّز يكلف عادةً بضع مئات من الدولارات، حسب عدد الخطوات والتكاملات ومنطق الذكاء
            الاصطناعي. أخبرني بالعملية التي تريد أتمتتها وسأعطيك سعراً ثابتاً قبل أن يبدأ أي عمل، بلا
            مفاجآت.
          </p>
          <div class="hero__actions">
            <a class="btn" href="/ar/contact">أخبرني بما تريد أتمتته</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="who-h">
      <div class="rail">
        <p class="eyebrow">مع من أعمل</p>
        <div>
          <h2 class="section-title" id="who-h">في أربيل حضورياً، وفي عموم العراق عن بُعد</h2>
          <p class="lede">
            أعمل مع الشركات الصغيرة والمتوسطة والوكالات ورواد الأعمال: حضورياً في أربيل وإقليم
            كردستان، وعن بُعد مع شركات في بغداد والبصرة والموصل والسليمانية والنجف وكربلاء وبقية
            المحافظات، ومع عملاء دوليين. ومعظم من يتواصل معي لديه عملية واحدة متكررة ومرهقة: ملاحقة
            موافقات الفواتير، أو تقييم العملاء الواردين، أو نقل البيانات بين الأدوات، أو إعداد التقرير
            نفسه كل أسبوع. وهذا بالضبط نوع العمل الذي وُجد <span lang="en">n8n</span> ليتولاه.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="how-h">
      <div class="rail">
        <p class="eyebrow">كيف يسير العمل</p>
        <div>
          <h2 class="section-title" id="how-h">من العملية إلى الإنتاج</h2>
          <ol class="disciplines">
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">01</span>
              <div class="discipline__main">
                <h3 class="discipline__term">تحديد نطاق العملية</h3>
                <p class="discipline__def">
                  نبدأ من المهمة المتكررة الفعلية التي تريد التخلص منها. أرسم الخطوات والأدوات
                  المستخدمة والمواضع التي يجب أن يبقى فيها قرار بشري، ثم أقدّم سعراً ثابتاً.
                </p>
              </div>
            </li>
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">02</span>
              <div class="discipline__main">
                <h3 class="discipline__term">البناء والاختبار</h3>
                <p class="discipline__def">
                  أبني سير العمل في <span lang="en">n8n</span> وأربط تطبيقاتك بالنموذج المناسب،
                  وأختبره على أمثلة حقيقية حتى يتصرف بشكل صحيح في الحالات الاستثنائية، لا في المسار
                  المثالي فقط.
                </p>
              </div>
            </li>
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">03</span>
              <div class="discipline__main">
                <h3 class="discipline__term">إضافة الضمانات</h3>
                <p class="discipline__def">
                  التحقق من البيانات والتسجيل والتنبيهات، حتى تفشل الأتمتة بصوت عالٍ لا بصمت، مع خطوة
                  موافقة بشرية في كل موضع يتعلق بالمال أو المخاطر.
                </p>
              </div>
            </li>
            <li class="discipline reveal">
              <span class="discipline__num" aria-hidden="true">04</span>
              <div class="discipline__main">
                <h3 class="discipline__term">التسليم موثّقاً</h3>
                <p class="discipline__def">
                  تستلم سير العمل، وشرحاً بلغة واضحة لكيفية عمله، وتوثيقاً يضمن ألّا يتعطل فريقك إذا لم
                  أكن موجوداً.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="proof-h">
      <div class="rail">
        <p class="eyebrow">إثبات</p>
        <div>
          <h2 class="section-title" id="proof-h">أعمال حقيقية، لا شرائح عرض</h2>
          <p class="lede">
            راجع <a href="/#projects">قسم المشاريع</a> لتطّلع على جدار حماية الفواتير من التلاعب، ونظام
            تقييم العملاء المحتملين بالذكاء الاصطناعي، ومسار الموافقات متعدد المراحل، إضافة إلى
            <a href="https://www.dad-link.com" target="_blank" rel="noopener">DAD LINK</a>، وهو متجر
            إلكتروني حقيقي بين الشركات لمعدات البنية التحتية للشبكات في العراق، صمّمته وأطلقته بنفسي.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="svc-faq-h">
      <div class="rail">
        <p class="eyebrow">إجابات سريعة</p>
        <div>
          <h2 class="section-title" id="svc-faq-h">
            أسئلة شائعة عن توظيف مطوّر <span lang="en">n8n</span>
          </h2>
          <dl class="faq">
            <div class="faq__item reveal">
              <dt class="faq__q">كيف أوظّف مطوّر <span lang="en">n8n</span> في العراق؟</dt>
              <dd class="faq__a">
                تواصل معي مباشرة عبر الموقع واشرح العملية التي تريد أتمتتها بجملتين. أحدّد النطاق،
                وأعطيك سعراً ثابتاً قبل بدء العمل، ثم أبني وأختبر وأسلّم سير العمل موثّقاً وجاهزاً.
                <a href="/ar/contact">تواصل معي</a>.
              </dd>
            </div>
            <div class="faq__item reveal">
              <dt class="faq__q">هل تعمل مع شركات خارج أربيل؟</dt>
              <dd class="faq__a">
                نعم. الأتمتة تُسلَّم عن بُعد بالكامل، لذلك أعمل مع شركات في بغداد والبصرة والموصل
                والسليمانية والنجف وكربلاء وبقية المحافظات، ومع عملاء دوليين.
              </dd>
            </div>
            <div class="faq__item reveal">
              <dt class="faq__q">ما الأدوات والنماذج التي تعمل بها؟</dt>
              <dd class="faq__a">
                <span lang="en">n8n</span> موصولاً بالبريد وجداول البيانات والتقويم وتيليغرام وأنظمة
                إدارة العملاء، وبنماذج <span lang="en">OpenAI</span> و<span lang="en">Claude</span>
                و<span lang="en">Gemini</span>. وعندما لا تكفي العُقد الجاهزة أكتب عُقداً برمجية مخصصة.
              </dd>
            </div>
            <div class="faq__item reveal">
              <dt class="faq__q">هل يمكنك استلام سير عمل موجود مسبقاً؟</dt>
              <dd class="faq__a">
                نعم. أراجع سير العمل القائم وأصحّحه وأوسّعه أو أستلمه بالكامل، وأضيف التحقق والتسجيل
                حتى يتوقف عن الفشل بصمت، وأوثّقه لفريقك.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="svc-contact-h">
      <div class="rail">
        <p class="eyebrow">تواصل</p>
        <div>
          {/*
            Iraqi colloquial, deliberately, and the only place on the Arabic
            pages that is. Everything else is Modern Standard Arabic, but this
            is the closing ask, where MSA reads like a press release and the
            spoken form reads like a person offering to help.
          */}
