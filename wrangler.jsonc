{
  // @astrojs/cloudflare generates `main` and `assets` at build time — declaring
  // them here breaks the build, because @cloudflare/vite-plugin validates `main`
  // before dist/ exists. Only bindings and account-level config belong here.
  //
  // Secrets (ADMIN_PASSWORD_HASH, SESSION_SECRET) are set with
  // `wrangler secret put <NAME>`, or via .dev.vars locally — never committed.
  "name": "ibrahimaher",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // `binding` and `directory` are still left to the adapter (see above) — only
  // this one knob is set here.
  //
  // The asset router runs BEFORE the Worker, and its default
  // `html_handling: "auto-trailing-slash"` special-cases any path ending in
  // `index.html`. Nothing in dist/client is HTML (every route is SSR from D1),
  // so that default has nothing legitimate to do here — it just swallows two
  // legacy URLs before src/middleware.ts can 301 them, and answers /index.html
  // with a 404 and /blog/index.html with a 500. Measured: with the default,
  // /about.html reached the middleware and redirected fine while both
  // index.html forms did not.
  //
  // "none" disables that special-casing only. Real assets (/_astro/*,
  // /assets/*, robots.txt, llms.txt) are matched by exact path and are
  // unaffected.
  "assets": {
    "html_handling": "none"
  },
  // The production hostnames. Declared here rather than passed on a single
  // deploy, so every later deploy reasserts them instead of depending on
  // whoever happened to run the cutover.
  //
  // These are ZONE ROUTES, not Custom Domains, and that is deliberate.
  //
  // Custom Domains cannot be attached here: both hostnames already resolve via
  // standing DNS records owned by the v1 PAGES project, so the attach fails
  // with 409 / code 100117 ("already has externally managed DNS records").
  // Detaching them from Pages does NOT clear those records — they persist in
  // the zone and must be deleted first, which needs dns_records:write. The
  // OAuth token carries zone:read only, so that door is closed.
  //
  // A zone route needs no DNS write at all: the hostname already resolves
  // (proxied, at the v1 Pages project), and a matching Worker route is
  // evaluated FIRST and wins. Verified 2026-07-17 by pointing a throwaway
  // `ibrahimaher.com/__cutovertest*` route at this Worker while the homepage
  // still served v1 — the test path returned this Worker's 404 and the rest of
  // the site stayed untouched. Propagation took ~30s, so a check run straight
  // after the API call reads as a failure when it is not.
  //
  // Consequence worth knowing: the Pages project still holds the custom domains
  // and is now a silent fallback. Deleting these two routes reverts the entire
  // site to v1 within a minute — that is the rollback, and it is why Pages is
  // deliberately left attached rather than tidied up.
  "routes": [
    { "pattern": "ibrahimaher.com/*", "zone_name": "ibrahimaher.com" },
    { "pattern": "www.ibrahimaher.com/*", "zone_name": "ibrahimaher.com" }
  ],
  // Explicit because declaring `routes` turns the workers.dev route OFF by
  // default — which silently 404'd the staging URL the moment the routes above
  // were added. With the custom domains not yet attached, that left the Worker
  // reachable at no hostname at all. Keep this true regardless: it is the
  // staging URL, and it costs nothing beside a custom domain.
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ibrahimaher-content",
      "database_id": "91a1959f-be34-4dc2-9507-adb7be1357c7"
    }
  ],
  // Astro's adapter enables sessions and expects a SESSION KV binding. Left to
  // auto-provision it tries to create this namespace on every deploy and fails
  // once it exists, so it is bound explicitly.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3342754c519347cab313af75d4bc11c0"
    }
  ],
  // Binary for admin-uploaded images. The `media` D1 table (migration 0002) was
  // always described as "the queryable index" for this bucket — key, url, mime,
  // bytes, dimensions — but the bucket itself never existed, so nothing could
  // write to it and every image path in the DB points at a build-time asset
  // under public/assets/ that only changes by committing a file and redeploying.
  //
  // R2 must be enabled on the ACCOUNT before this binding can resolve: the API
  // answers `code: 10042 "Please enable R2 through the Cloudflare Dashboard"`,
  // and no API token can flip that switch — it is a one-time dashboard action.
  // Enabled and bucket created 2026-07-17.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ibrahimaher-media"
    }
  ]
}
