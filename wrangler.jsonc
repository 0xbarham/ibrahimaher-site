{
  // @astrojs/cloudflare generates `main` and `assets` at build time — declaring
  // them here breaks the build, because @cloudflare/vite-plugin validates `main`
  // before dist/ exists. Only bindings and account-level config belong here.
  //
  // Secrets (ADMIN_PASSWORD_HASH, SESSION_SECRET) are set with
  // `wrangler secret put <NAME>`, or via .dev.vars locally — never committed.
  "name": "ibrahimaher",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // The production hostnames. Declared here rather than passed as --domains on
  // a single deploy, so every later deploy reasserts them instead of depending
  // on whoever happened to run the cutover.
  //
  // NOT YET ATTACHED as of 2026-07-17. Both hostnames still point at the v1
  // PAGES project, and the attach fails with 409 / code 100117: "already has
  // externally managed DNS records". Detaching them from Pages does NOT clear
  // those records — they are standing records in the zone, so they must be
  // deleted before a Worker Custom Domain can take the hostname. Doing that
  // needs dns_records:write, which the current OAuth token does not carry
  // (zone:read only). Until the records are removed, deploys will report
  // "Some triggers failed to deploy" and only workers.dev will serve.
  "routes": [
    { "pattern": "ibrahimaher.com", "custom_domain": true },
    { "pattern": "www.ibrahimaher.com", "custom_domain": true }
  ],
  // Explicit because declaring `routes` turns the workers.dev route OFF by
  // default — which silently 404'd the staging URL the moment the routes above
  // were added. With the custom domains not yet attached, that left the Worker
  // reachable at no hostname at all. Keep this true regardless: it is the
  // staging URL, and it costs nothing beside a custom domain.
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ibrahimaher-content",
      "database_id": "91a1959f-be34-4dc2-9507-adb7be1357c7"
    }
  ],
  // Astro's adapter enables sessions and expects a SESSION KV binding. Left to
  // auto-provision it tries to create this namespace on every deploy and fails
  // once it exists, so it is bound explicitly.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3342754c519347cab313af75d4bc11c0"
    }
  ]
}
